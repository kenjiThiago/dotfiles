@import "~/.config/rofi/themes/center.rasi"

window {
    width: calc(1000px min 95%);
    height: calc(520px min 90%);
}

mainbox {
    orientation: vertical;
    children: [ "inputbar", "preview-body", "textbox-preview-help" ];
}

inputbar {
    expand: false;
}

preview-body {
    expand: true;
    orientation: horizontal;
    spacing: 16px;
    margin: 16px 0px 0px;
    children: [ "listview", "icon-current-entry" ];
    background-color: transparent;
}

listview {
    /* Sem expansão, a lista não calcula largura própria nessa caixa horizontal. */
    expand: true;
    margin: 0px;
    dynamic: false;
    fixed-height: true;
}

element {
    children: [ "element-text" ];
}

icon-current-entry {
    expand: true;
    squared: true;
    size: 440px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: @surface;
    border: 1px solid;
    border-color: @overlay;
    border-radius: 10px;
    padding: 12px;
}

textbox-preview-help {
    expand: false;
    font: "Hack Nerd Font 9";
    text-color: @subtle;
    background-color: transparent;
    margin: 16px 0px 0px;
    padding: 12px 2px 0px;
    border: 1px 0px 0px;
    border-color: @overlay;
}
