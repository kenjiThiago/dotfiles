configuration {
    modi:                       "drun";
    show-icons:                 true;
    display-drun:               "Aplicativos";
    drun-display-format:        "{name}";
    font:                       "Hack Nerd Font 10";
}

/* colors.rasi é gerado por `theme set`. */
@import "colors.rasi"

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       calc(540px min 90%);
    x-offset:                    0px;
    y-offset:                    0px;
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      1px solid;
    border-radius:               16px;
    border-color:                @highlight-med;
    background-color:            @base;
    cursor:                      "default";
}

mainbox {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     20px;
    border:                      0px solid;
    background-color:            transparent;
    children:                    [ "inputbar", "listview", "textbox-help" ];
}

inputbar {
    enabled:                     true;
    expand:                      false;
    spacing:                     12px;
    margin:                      0px;
    padding:                     12px 14px;
    border:                      1px solid;
    border-color:                @overlay;
    border-radius:               10px;
    background-color:            @surface;
    text-color:                  @text;
    children:                    [ "textbox-search", "prompt", "entry", "num-filtered-rows" ];
}

textbox-search {
    expand:                      false;
    width:                       18px;
    content:                     "";
    background-color:            transparent;
    text-color:                  @subtle;
    vertical-align:              0.5;
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @accent;
}

textbox-prompt-colon {
    enabled:                     false;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @text;
    cursor:                      text;
    placeholder:                 "Pesquisar…";
    placeholder-color:           @subtle;
}

num-filtered-rows {
    expand:                      false;
    background-color:            transparent;
    text-color:                  @subtle;
    vertical-align:              0.5;
    horizontal-align:            1.0;
}

listview {
    enabled:                     true;
    expand:                      true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     4px;
    margin:                      16px 0px 0px;
    padding:                     0px;
    border:                      0px solid;
    background-color:            transparent;
    text-color:                  @text;
    cursor:                      "default";
}

element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     10px 12px;
    border:                      0px 0px 0px 2px;
    border-color:                transparent;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  @text;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @text;
}

element alternate.normal {
    background-color:            transparent;
    text-color:                  @text;
}

element selected.normal {
    background-color:            @overlay;
    border-color:                @accent;
    text-color:                  @text;
}

element normal.active {
    background-color:            transparent;
    text-color:                  @accent;
}

element alternate.active {
    background-color:            transparent;
    text-color:                  @accent;
}

element selected.active {
    background-color:            @overlay;
    border-color:                @accent;
    text-color:                  @text;
}

element normal.urgent {
    background-color:            transparent;
    text-color:                  @error;
}

element alternate.urgent {
    background-color:            transparent;
    text-color:                  @error;
}

element selected.urgent {
    background-color:            @overlay;
    border-color:                @error;
    text-color:                  @error;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        20px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   bold;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

textbox-help {
    expand:                      false;
    content:                     "↑↓ navegar · Enter selecionar · Esc fechar";
    font:                        "Hack Nerd Font 9";
    text-color:                  @subtle;
    background-color:            transparent;
    margin:                      16px 0px 0px;
    padding:                     12px 2px 0px;
    border:                      1px 0px 0px;
    border-color:                @overlay;
}
