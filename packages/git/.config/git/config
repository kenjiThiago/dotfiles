# Identidade fica fora do repositório, em ~/.config/git/config.local:
#
#   [user]
#       name = Seu Nome
#       email = voce@exemplo.com
#
# O git ignora o include se o arquivo não existir.
[include]
    path = config.local

[core]
    excludesFile = ~/.config/git/ignore

[init]
    defaultBranch = main

[push]
    autoSetupRemote = true
    followTags = true

[pull]
    rebase = true

[fetch]
    prune = true
    pruneTags = true

[rebase]
    autoStash = true
    autoSquash = true
    updateRefs = true

[merge]
    conflictStyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = default
    mnemonicPrefix = true
    renames = copies

[rerere]
    enabled = true
    autoUpdate = true

[branch]
    sort = -committerdate

[tag]
    sort = -version:refname

[log]
    date = iso

[alias]
    s = status --short --branch
    l = log --oneline --graph --decorate -20
    d = diff
    ds = diff --staged
    sw = switch
    swc = switch --create
    f = fetch --all --prune
    amend = commit --amend --no-edit
    rc = rebase --continue
    ra = rebase --abort
    undo = reset --soft HEAD~1
    ahead = log --oneline --no-merges @{upstream}..HEAD
    filelog = log --follow -p --
    authors = shortlog --summary --numbered --email --
