#!/usr/bin/env bash
# nvim-open-file: acha um arquivo por fzf e manda o :e para um pane do tmux.
#
# É o lugar do telescope no perfil servidor, onde não há plugin nenhum. Quem
# chama é o <leader>pf do NeoVim.server, que passa o window_id do tmux: o fzf
# roda num popup próprio, então o :e precisa voltar para a janela de origem.

TARGET_PANE="$1"

if [[ -z $TARGET_PANE ]]; then
    echo "uso: nvim-open-file <window_id do tmux>" >&2
    exit 1
fi

# Mostra "arquivo → pai/arquivo" e casa contra o caminho inteiro, mas manda só
# o caminho (segundo campo) para o nvim.
selected=$(fd --type f --hidden --exclude .git . . |
    awk -F/ '{
        if (NF > 1) path_2 = $(NF-1) "/" $NF; else path_2 = $NF;
        print $NF " → " path_2 "\t" $0
    }' |
    fzf --height 40% --tmux center --layout reverse \
        --delimiter "\t" --with-nth 1 \
        --tiebreak=begin \
        --header "Selecione o arquivo para abrir no Nvim" |
    cut -f2)

if [[ -z $selected ]]; then
    exit 0
fi

tmux send-keys -t "$TARGET_PANE" Escape ":e $(printf '%q' "$selected")" C-m
