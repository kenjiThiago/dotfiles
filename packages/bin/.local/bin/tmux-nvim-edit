#!/usr/bin/env bash
# tmux-nvim-edit: abre o arquivo num Neovim existente ou em uma janela nova.

if [[ -z ${1:-} || ( -n ${2:-} && ! $2 =~ ^[1-9][0-9]*$ ) ]]; then
    echo "uso: tmux-nvim-edit ARQUIVO [LINHA]" >&2
    exit 1
fi

arquivo=$(realpath -- "$1") || exit 1
linha=${2:-}
sessao=$(tmux display-message -p '#S') || exit 1

alvo=$(tmux list-panes -s -t "=$sessao" -F '#{pane_id} #{pane_current_command} #{window_name}' |
    awk '$2 == "nvim" && $3 !~ /^_scratch_/ { print $1; exit }')

if [[ -n $alvo ]]; then
    # Escapes decimais de bytes preservam UTF-8 e qualquer delimitador no caminho.
    arquivo_lua=$(printf '%s' "$arquivo" | od -An -v -tu1 |
        awk '{ for (i = 1; i <= NF; i++) printf "\\%03d", $i }')
    comando=":lua vim.fn.histdel('cmd', -1); vim.cmd('edit ${linha:++$linha }' .. vim.fn.fnameescape(\"$arquivo_lua\"))"
    tmux send-keys -t "$alvo" 'C-\' 'C-n' Escape Escape
    tmux send-keys -l -t "$alvo" "$comando"
    tmux send-keys -t "$alvo" Enter
    tmux select-window -t "$alvo"
    tmux select-pane -t "$alvo"
else
    comando=(nvim)
    [[ -n $linha ]] && comando+=("+$linha")
    tmux new-window -t "$sessao:" -c "$PWD" "${comando[@]}" -- "$arquivo"
fi
