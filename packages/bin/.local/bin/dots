#!/usr/bin/env bash
# dots — wrapper de GNU Stow para este repositório.
#
#   dots list                   lista os pacotes disponíveis
#   dots status                 mostra links ausentes, incorretos e quebrados
#   dots link [pacote...]       linka (padrão: os do perfil ativo)
#   dots unlink [pacote...]     desfaz os links
#   dots relink [pacote...]     unlink + link (útil depois de renomear coisas)
#   dots migrate                remove symlinks quebrados que apontam para o repo
#   dots adopt [pacote...]      importa para o repo o que já existe em ~
#
#   --dry                       só mostra o que faria
#   --yes                       não pergunta antes de remover (só no migrate)
#   --except a,b                linka todos menos esses (link/unlink/relink)
#   --profile <nome>            usa outro perfil em vez do ativo

# --no-folding em tudo: ~/.config/<pacote> vira diretório real com symlinks dentro,
# e o `theme` grava os arquivos gerados ao lado sem escrever no repositório.

set -euo pipefail

self=$(realpath "${BASH_SOURCE[0]}")
DOTFILES=${DOTFILES:-$(cd "$(dirname "$self")/../../../.." && pwd)}
PKG_DIR="$DOTFILES/packages"
PROFILES_DIR="$DOTFILES/profiles"
PROFILE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/profile"

DRY=0
ASSUME_YES=0
EXCEPT=()
PROFILE=""

info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m ✔\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m !!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m ✗\033[0m %s\n' "$*" >&2; exit 1; }

all_packages() {
    find "$PKG_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
}

current_profile() {
    if [[ -n $PROFILE ]]; then printf '%s\n' "$PROFILE"; return; fi
    if [[ -n ${DOTFILES_PROFILE:-} ]]; then printf '%s\n' "$DOTFILES_PROFILE"; return; fi
    if [[ -r $PROFILE_FILE ]]; then
        local name
        read -r name < "$PROFILE_FILE" || true
        if [[ -n ${name// /} ]]; then printf '%s\n' "$name"; return; fi
    fi
    printf 'desktop\n'
}

profile_packages() {
    local name=$1 file="$PROFILES_DIR/$1"

    if [[ ! -r $file ]]; then
        all_packages
        return
    fi

    sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "$file"
}

# Comparação por nome inteiro: excluir 'nvim' não leva o 'nvim-plugins' junto.
except_packages() {
    local pkg name skip
    while IFS= read -r pkg; do
        skip=0
        for name in "$@"; do
            if [[ $pkg == "$name" ]]; then skip=1; break; fi
        done
        if [[ $skip == 0 ]]; then printf '%s\n' "$pkg"; fi
    done < <(profile_packages "$(current_profile)")
}

stow_cmd() {
    local action=$1; shift
    local flags=(--no-folding -d "$PKG_DIR" -t "$HOME" -v)
    if [[ $DRY == 1 ]]; then flags+=(--simulate); fi

    case $action in
        link)   stow "${flags[@]}" -S "$@" ;;
        unlink) stow "${flags[@]}" -D "$@" ;;
        relink) stow "${flags[@]}" -R "$@" ;;
    esac
}

check_packages() {
    local pkg
    for pkg in "$@"; do
        [[ -d $PKG_DIR/$pkg ]] || die "pacote '$pkg' não existe (veja: dots list)"
    done
}

# Symlinks quebrados para dentro do repo, sobra do layout antigo que o stow não sobrescreve.
stale_links() {
    local link raw target
    while IFS= read -r link; do
        raw=$(readlink "$link")
        target=$(cd "$(dirname "$link")" && realpath -m "$raw")
        [[ $target == "$DOTFILES"/* ]] || continue
        [[ -e $target ]] && continue
        printf '%s\n' "$link"
    done < <(
        find "$HOME" -maxdepth 1 -type l 2>/dev/null
        find "$HOME/.config" "$HOME/.local" -maxdepth 3 -type l 2>/dev/null
    )
}

# O --adopt sobrescreve a versão do repositório com a que já existe em ~.
cmd_adopt() {
    local packages=("$@")
    if [[ ${#packages[@]} -eq 0 ]]; then
        die "diga quais pacotes adotar (veja: dots list)"
    fi
    check_packages "${packages[@]}"

    if [[ -n $(git -C "$DOTFILES" status --porcelain 2>/dev/null) ]]; then
        die "o repositório tem mudanças pendentes; commite ou descarte antes, senão não dá para saber o que veio de ~"
    fi

    local flags=(--no-folding -d "$PKG_DIR" -t "$HOME" -v --adopt)
    if [[ $DRY == 1 ]]; then flags+=(--simulate); fi

    info "adotando: ${packages[*]}"
    stow "${flags[@]}" -S "${packages[@]}"
    if [[ $DRY == 1 ]]; then return 0; fi

    if [[ -n $(git -C "$DOTFILES" status --porcelain) ]]; then
        warn "estes arquivos vieram de ~ e sobrescreveram o repositório:"
        git -C "$DOTFILES" --no-pager diff --stat
        printf '   revise com  git -C %s diff\n' "${DOTFILES/#$HOME/~}"
        printf '   desfaça com git -C %s checkout -- .\n' "${DOTFILES/#$HOME/~}"
    else
        ok "o que estava em ~ já era idêntico ao repositório"
    fi
}

cmd_migrate() {
    local -a stale=()
    mapfile -t stale < <(stale_links)

    if [[ ${#stale[@]} -eq 0 ]]; then
        ok "nenhum symlink quebrado apontando para $DOTFILES"
        return 0
    fi

    info "${#stale[@]} symlink(s) quebrado(s) apontando para o repositório:"
    local link
    for link in "${stale[@]}"; do
        printf '   %-42s -> %s\n' "${link/#$HOME/\~}" "$(readlink "$link")"
    done

    if [[ $DRY == 1 ]]; then
        printf '\n\033[2;37m[dry]\033[0m nada foi removido\n'
        return 0
    fi

    if [[ $ASSUME_YES == 0 ]]; then
        local answer
        read -rp $'\nRemover? Arquivos e diretórios de verdade não são tocados. [s/N] ' answer
        [[ $answer == [sSyY] ]] || { warn "cancelado"; return 0; }
    fi

    rm -f "${stale[@]}"
    ok "removidos; agora rode: dots link"
}

status_broken_links() {
    local target_dir=$1 dir link target
    while IFS= read -r -d '' link; do
        [[ -e $link ]] && continue
        target=$(realpath -m -- "$link") || continue
        [[ $target == "$DOTFILES"/* ]] || continue
        printf '%s\0' "$link"
    done < <(
        find "$target_dir" -maxdepth 1 -type l -print0 2>/dev/null
        while IFS= read -r -d '' dir; do
            [[ -d $target_dir/$dir && ! -L $target_dir/$dir ]] || continue
            if [[ $dir == */* ]]; then
                find "$target_dir/$dir" -type l -print0 2>/dev/null
            else
                find "$target_dir/$dir" -maxdepth 1 -type l -print0 2>/dev/null
            fi
        done < <(
            find "$PKG_DIR" -mindepth 2 -maxdepth 3 -type d -printf '%P\0' |
                cut -z -d / -f 2- | sort -zu
        )
    ) | sort -zu
}

cmd_status() {
    local target_dir=${1:-$HOME}
    local pkg file target total state mostrar link resolved
    local ausentes incorretos quebrados
    local -a faltando=() broken=()
    for pkg in $(all_packages); do
        total=0
        ausentes=0
        incorretos=0
        quebrados=0
        faltando=()
        while IFS= read -r -d '' file; do
            total=$((total + 1))
            target="$target_dir/$file"
            if [[ -L $target && ! -e $target ]]; then
                state="link quebrado -> $(readlink "$target")"
                quebrados=$((quebrados + 1))
            elif [[ -L $target && $(realpath "$target" 2>/dev/null) == "$PKG_DIR/$pkg/$file" ]]; then
                continue
            elif [[ -L $target ]]; then
                state="destino incorreto -> $(readlink "$target")"
                incorretos=$((incorretos + 1))
            elif [[ -e $target ]]; then
                state="destino incorreto: não é symlink"
                incorretos=$((incorretos + 1))
            else
                state="link ausente"
                ausentes=$((ausentes + 1))
            fi
            faltando+=("$file [$state]")
        done < <(find "$PKG_DIR/$pkg" -type f -printf '%P\0' | sort -z)

        if [[ $total -gt 0 && ${#faltando[@]} -eq 0 ]]; then
            printf '  \033[1;32m●\033[0m %s\n' "$pkg"
        elif [[ $ausentes -eq $total ]]; then
            printf '  \033[2;37m○\033[0m %s (%d links ausentes: dots link %s)\n' "$pkg" "$ausentes" "$pkg"
        else
            printf '  \033[1;33m◐\033[0m %s (%d ausentes, %d incorretos, %d quebrados)\n' \
                "$pkg" "$ausentes" "$incorretos" "$quebrados"
            for file in "${faltando[@]:0:5}"; do
                printf '      \033[2;37m%s\033[0m\n' "$file"
            done
            mostrar=$((${#faltando[@]} - 5))
            if [[ $mostrar -gt 0 ]]; then
                printf '      \033[2;37me mais %d\033[0m\n' "$mostrar"
            fi
            if [[ $ausentes -gt 0 ]]; then
                printf '      Novos links: dots link %s\n' "$pkg"
            fi
        fi
    done

    mapfile -d '' -t broken < <(status_broken_links "$target_dir")
    if [[ ${#broken[@]} -gt 0 ]]; then
        printf '\n  \033[1;33mSymlinks quebrados para o repositório (%d):\033[0m\n' "${#broken[@]}"
        for link in "${broken[@]}"; do
            resolved=$(realpath -m -- "$link")
            printf '      %s -> %s\n' "${link/#$target_dir/\~}" "$resolved"
        done
        printf '  Revise os destinos e use dots relink <pacote> após renomear ou remover arquivos.\n'
    else
        printf '\n  Nenhum symlink quebrado para o repositório nos diretórios verificados.\n'
    fi
}

command -v stow >/dev/null || die "GNU Stow não está instalado (paru -S stow)"
[[ -d $PKG_DIR ]] || die "não encontrei $PKG_DIR — defina \$DOTFILES"

args=()
while [[ $# -gt 0 ]]; do
    case $1 in
        --dry|--dry-run) DRY=1 ;;
        -y|--yes)        ASSUME_YES=1 ;;
        --except)        shift
                         if [[ $# -eq 0 ]] || [[ $1 == -* ]]; then
                             die "--except precisa de uma lista de pacotes"
                         fi
                         IFS=',' read -ra names <<< "$1"; EXCEPT+=("${names[@]}") ;;
        --except=*)      IFS=',' read -ra names <<< "${1#*=}"; EXCEPT+=("${names[@]}") ;;
        --profile)       shift; PROFILE=${1:?--profile precisa de um nome} ;;
        --profile=*)     PROFILE=${1#*=} ;;
        -h|--help)       sed -n '2,/^$/{/^#/s/^# \?//p}' "$self"; exit 0 ;;
        *)               args+=("$1") ;;
    esac
    shift
done
set -- "${args[@]+"${args[@]}"}"

action=${1:-link}
shift || true

if [[ ${#EXCEPT[@]} -gt 0 ]]; then
    case $action in
        link|unlink|relink) ;;
        *) die "--except só vale para link, unlink e relink" ;;
    esac
fi

if [[ -n $PROFILE ]]; then
    case $action in
        link|unlink|relink) ;;
        *) die "--profile só vale para link, unlink e relink" ;;
    esac
    [[ -r $PROFILES_DIR/$PROFILE ]] \
        || die "perfil '$PROFILE' não existe (veja: ls $PROFILES_DIR)"
fi

case $action in
    list)    all_packages ;;
    status)  cmd_status ;;
    migrate) cmd_migrate ;;
    adopt)   cmd_adopt "$@" ;;
    link|unlink|relink)
        if [[ $# -gt 0 ]]; then
            if [[ ${#EXCEPT[@]} -gt 0 ]]; then
                die "--except não combina com uma lista de pacotes; use um ou outro"
            fi
            check_packages "$@"
            packages=("$@")
        elif [[ ${#EXCEPT[@]} -gt 0 ]]; then
            check_packages "${EXCEPT[@]}"
            mapfile -t packages < <(except_packages "${EXCEPT[@]}")
            [[ ${#packages[@]} -gt 0 ]] || die "--except não deixou nenhum pacote de fora"
            info "perfil: $(current_profile), pulando: ${EXCEPT[*]}"
        else
            mapfile -t packages < <(profile_packages "$(current_profile)")
            [[ ${#packages[@]} -gt 0 ]] || die "o perfil '$(current_profile)' não lista nenhum pacote"
            check_packages "${packages[@]}"
            info "perfil: $(current_profile)"
        fi
        info "${action} de: ${packages[*]}"
        stow_cmd "$action" "${packages[@]}"
        if [[ $DRY == 0 ]]; then ok "pronto"; fi
        ;;
    *) die "comando desconhecido '$action' (veja: dots --help)" ;;
esac
