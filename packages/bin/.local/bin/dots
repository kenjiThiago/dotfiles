#!/usr/bin/env bash
# dots — wrapper de GNU Stow para este repositório.
#
#   dots list                   lista os pacotes disponíveis
#   dots status                 mostra quais estão linkados
#   dots link [pacote...]       linka (padrão: todos)
#   dots unlink [pacote...]     desfaz os links
#   dots relink [pacote...]     unlink + link (útil depois de renomear coisas)
#   dots migrate                remove symlinks quebrados que apontam para o repo
#   dots adopt [pacote...]      importa para o repo o que já existe em ~
#
#   --dry                       só mostra o que faria
#   --yes                       não pergunta antes de remover (só no migrate)
#   --except a,b                linka todos menos esses (link/unlink/relink)
#
# O --except é o avesso de passar nomes: 'dots link' pega tudo, 'dots link nvim'
# pega só o nvim, e 'dots link --except nvim' pega tudo menos ele. Os nomes são
# validados, então errar a grafia dá erro em vez de linkar tudo caladamente.
#
# Todos os comandos usam --no-folding de propósito: assim ~/.config/waybar é
# um diretório de verdade com symlinks dentro, e não um symlink para o repo.
# Isso é o que permite ao `theme` escrever colors.css ao lado do style.css sem
# sujar o repositório.

set -euo pipefail

self=$(realpath "${BASH_SOURCE[0]}")
DOTFILES=${DOTFILES:-$(cd "$(dirname "$self")/../../../.." && pwd)}
PKG_DIR="$DOTFILES/packages"

DRY=0
ASSUME_YES=0
EXCEPT=()

info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m ✔\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m !!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m ✗\033[0m %s\n' "$*" >&2; exit 1; }

all_packages() {
    find "$PKG_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
}

# Todos os pacotes menos os nomes passados. A comparação é de nome inteiro de
# propósito: excluir 'nvim' não pode levar o 'nvim-plugins' junto.
except_packages() {
    local pkg name skip
    while IFS= read -r pkg; do
        skip=0
        for name in "$@"; do
            if [[ $pkg == "$name" ]]; then skip=1; break; fi
        done
        if [[ $skip == 0 ]]; then printf '%s\n' "$pkg"; fi
    done < <(all_packages)
}

stow_cmd() {
    local action=$1; shift
    local flags=(--no-folding -d "$PKG_DIR" -t "$HOME" -v)
    if [[ $DRY == 1 ]]; then flags+=(--simulate); fi

    case $action in
        link)   stow "${flags[@]}" -S "$@" ;;
        unlink) stow "${flags[@]}" -D "$@" ;;
        relink) stow "${flags[@]}" -R "$@" ;;
    esac
}

check_packages() {
    local pkg
    for pkg in "$@"; do
        [[ -d $PKG_DIR/$pkg ]] || die "pacote '$pkg' não existe (veja: dots list)"
    done
}

# Symlinks que apontam para dentro do repositório mas não resolvem mais.
# É o que sobra ao trocar de layout: os links do stow antigo apontavam para
# <repo>/config/..., caminho que deixou de existir, e o stow se recusa a
# sobrescrever porque não reconhece como dele.
stale_links() {
    local link raw target
    while IFS= read -r link; do
        raw=$(readlink "$link")
        target=$(cd "$(dirname "$link")" && realpath -m "$raw")
        [[ $target == "$DOTFILES"/* ]] || continue
        [[ -e $target ]] && continue
        printf '%s\n' "$link"
    done < <(
        find "$HOME" -maxdepth 1 -type l 2>/dev/null
        find "$HOME/.config" "$HOME/.local" -maxdepth 3 -type l 2>/dev/null
    )
}

# O --adopt do stow move o arquivo de ~ para dentro do pacote, sobrescrevendo
# a versão do repositório, e só então linka. Serve para importar uma config que
# já existe na máquina — o contrário de instalar uma que você já versionou.
cmd_adopt() {
    local packages=("$@")
    if [[ ${#packages[@]} -eq 0 ]]; then
        die "diga quais pacotes adotar (veja: dots list)"
    fi
    check_packages "${packages[@]}"

    if [[ -n $(git -C "$DOTFILES" status --porcelain 2>/dev/null) ]]; then
        die "o repositório tem mudanças pendentes; commite ou descarte antes, senão não dá para saber o que veio de ~"
    fi

    local flags=(--no-folding -d "$PKG_DIR" -t "$HOME" -v --adopt)
    if [[ $DRY == 1 ]]; then flags+=(--simulate); fi

    info "adotando: ${packages[*]}"
    stow "${flags[@]}" -S "${packages[@]}"
    if [[ $DRY == 1 ]]; then return 0; fi

    if [[ -n $(git -C "$DOTFILES" status --porcelain) ]]; then
        warn "estes arquivos vieram de ~ e sobrescreveram o repositório:"
        git -C "$DOTFILES" --no-pager diff --stat
        printf '   revise com  git -C %s diff\n' "${DOTFILES/#$HOME/~}"
        printf '   desfaça com git -C %s checkout -- .\n' "${DOTFILES/#$HOME/~}"
    else
        ok "o que estava em ~ já era idêntico ao repositório"
    fi
}

cmd_migrate() {
    local -a stale=()
    mapfile -t stale < <(stale_links)

    if [[ ${#stale[@]} -eq 0 ]]; then
        ok "nenhum symlink quebrado apontando para $DOTFILES"
        return 0
    fi

    info "${#stale[@]} symlink(s) quebrado(s) apontando para o repositório:"
    local link
    for link in "${stale[@]}"; do
        printf '   %-42s -> %s\n' "${link/#$HOME/\~}" "$(readlink "$link")"
    done

    if [[ $DRY == 1 ]]; then
        printf '\n\033[2;37m[dry]\033[0m nada foi removido\n'
        return 0
    fi

    if [[ $ASSUME_YES == 0 ]]; then
        local answer
        read -rp $'\nRemover? Arquivos e diretórios de verdade não são tocados. [s/N] ' answer
        [[ $answer == [sSyY] ]] || { warn "cancelado"; return 0; }
    fi

    rm -f "${stale[@]}"
    ok "removidos; agora rode: dots link"
}

cmd_status() {
    local pkg first target
    for pkg in $(all_packages); do
        first=$(find "$PKG_DIR/$pkg" -type f -printf '%P\n' | head -n 1)
        target="$HOME/$first"
        if [[ -L $target && $(realpath "$target" 2>/dev/null) == "$PKG_DIR/$pkg/$first" ]]; then
            printf '  \033[1;32m●\033[0m %s\n' "$pkg"
        else
            printf '  \033[2;37m○\033[0m %s\n' "$pkg"
        fi
    done
}

command -v stow >/dev/null || die "GNU Stow não está instalado (paru -S stow)"
[[ -d $PKG_DIR ]] || die "não encontrei $PKG_DIR — defina \$DOTFILES"

args=()
while [[ $# -gt 0 ]]; do
    case $1 in
        --dry|--dry-run) DRY=1 ;;
        -y|--yes)        ASSUME_YES=1 ;;
        --except)        shift
                         if [[ $# -eq 0 ]] || [[ $1 == -* ]]; then
                             die "--except precisa de uma lista de pacotes"
                         fi
                         IFS=',' read -ra names <<< "$1"; EXCEPT+=("${names[@]}") ;;
        --except=*)      IFS=',' read -ra names <<< "${1#*=}"; EXCEPT+=("${names[@]}") ;;
        -h|--help)       sed -n '2,23p' "$self" | sed 's/^# \?//'; exit 0 ;;
        *)               args+=("$1") ;;
    esac
    shift
done
set -- "${args[@]+"${args[@]}"}"

action=${1:-link}
shift || true

if [[ ${#EXCEPT[@]} -gt 0 ]]; then
    case $action in
        link|unlink|relink) ;;
        *) die "--except só vale para link, unlink e relink" ;;
    esac
fi

case $action in
    list)    all_packages ;;
    status)  cmd_status ;;
    migrate) cmd_migrate ;;
    adopt)   cmd_adopt "$@" ;;
    link|unlink|relink)
        if [[ $# -gt 0 ]]; then
            if [[ ${#EXCEPT[@]} -gt 0 ]]; then
                die "--except não combina com uma lista de pacotes; use um ou outro"
            fi
            check_packages "$@"
            packages=("$@")
        elif [[ ${#EXCEPT[@]} -gt 0 ]]; then
            check_packages "${EXCEPT[@]}"
            mapfile -t packages < <(except_packages "${EXCEPT[@]}")
            [[ ${#packages[@]} -gt 0 ]] || die "--except não deixou nenhum pacote de fora"
            info "pulando: ${EXCEPT[*]}"
        else
            mapfile -t packages < <(all_packages)
        fi
        info "${action} de: ${packages[*]}"
        stow_cmd "$action" "${packages[@]}"
        if [[ $DRY == 0 ]]; then ok "pronto"; fi
        ;;
    *) die "comando desconhecido '$action' (veja: dots --help)" ;;
esac
