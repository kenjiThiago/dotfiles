#!/usr/bin/env bash
# tmux-yazi-edit — abre arquivos do yazi fora do popup.

set -euo pipefail

if [ "$#" -eq 0 ]; then
    echo "uso: tmux-yazi-edit <arquivo>..."
    exit 1
fi

files=()
for f in "$@"; do
    files+=("$(realpath -m -- "$f")")
done

# =====================================================================
# NOVA LÓGICA: Se $NVIM existir, fomos chamados por um Neovim rodando!
# =====================================================================
if [[ -n "${NVIM:-}" ]]; then
    # Manda a instância atual do Neovim abrir os arquivos
    nvim --server "$NVIM" --remote "${files[@]}"

    tmux kill-session -t "scratch-yazi"

    exit 0 # Encerra o script com sucesso aqui
fi
# =====================================================================

nvim_cmd=(nvim "${files[@]}")

# (Daqui pra baixo, continua a lógica original para quando você
# abrir o tmux-yazi direto do terminal normal do Tmux)

if [[ -z ${TMUX:-} ]]; then
    exec "${nvim_cmd[@]}"
fi

if [[ -n ${TMUX_PANE:-} ]]; then
    self_session=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}')
else
    self_session=$(tmux display-message -p '#{session_name}')
fi

origin=$(tmux list-clients -F '#{client_session}' \
    | grep -vxF "$self_session" | head -n 1 || true)

if [[ -z $origin ]]; then
    exec "${nvim_cmd[@]}"
fi

pane=$(tmux display-message -p -t "$origin" '#{pane_id}')
running=$(tmux display-message -p -t "$pane" '#{pane_current_command}')

quoted=$(printf '%q ' "${nvim_cmd[@]}")

case $running in
    zsh|bash|sh|fish|dash)
        tmux send-keys -t "$pane" "$quoted" Enter
        ;;
    *)
        first_dir=$(dirname -- "${files[0]}")
        tmux new-window -t "$origin:" -c "$first_dir" "${nvim_cmd[@]}"
        ;;
esac

tmux detach-client -s "$self_session"
