#!/usr/bin/env bash
# theme — troca o tema de todo o desktop de uma vez.
#
#   theme                 abre o seletor (rofi se disponível, senão fzf)
#   theme list            lista os temas disponíveis
#   theme current         mostra o tema ativo
#   theme set <nome>      aplica um tema
#   theme reload          reaplica o tema atual (útil ao editar templates)
#   theme show [<nome>]   imprime a paleta no terminal
#
#   --dry                 mostra o que seria feito, sem escrever nada
#   --no-reload           gera os arquivos mas não recarrega os programas
#
# Como funciona: cada tema em themes/<nome>/theme.sh define uma paleta em
# nomes genéricos (base, surface, text, red, accent, ...). Cada template em
# themes/templates/ traduz essa paleta para o formato de um programa. O
# manifest diz para onde cada arquivo gerado vai.

set -euo pipefail

# ── Localização do repositório ────────────────────────────────────────────────
# O script vive em packages/bin/.local/bin/, então a raiz do repo está 4
# níveis acima — mesmo quando chamado através do symlink do stow.
self=$(realpath "${BASH_SOURCE[0]}")
DOTFILES=${DOTFILES:-$(cd "$(dirname "$self")/../../../.." && pwd)}

THEMES_DIR="$DOTFILES/themes"
TEMPLATES_DIR="$THEMES_DIR/templates"
MANIFEST="$TEMPLATES_DIR/manifest"
ZEN_THEMES_DIR="$DOTFILES/zen-themes"
WALLPAPER_DIR="$DOTFILES/wallpapers"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
STATE_FILE="$STATE_DIR/current-theme"

DRY=0
RELOAD=1

# ── Chaves da paleta ──────────────────────────────────────────────────────────
COLOR_KEYS=(
    base surface overlay term_bg
    highlight_low highlight_med highlight_high
    muted subtle text
    black red green yellow blue magenta cyan white
    bright_black bright_red bright_green bright_yellow
    bright_blue bright_magenta bright_cyan bright_white
    accent accent_alt success warning error info
)
META_KEYS=(variant nvim_colorscheme zen_theme wallpaper gtk_theme cursor_theme)

# ── Saída ─────────────────────────────────────────────────────────────────────
msg()   { printf '\033[1;34m::\033[0m %s\n' "$*"; }
ok()    { printf '\033[1;32m ✔\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m !!\033[0m %s\n' "$*" >&2; }
die()   { printf '\033[1;31m ✗\033[0m %s\n' "$*" >&2; exit 1; }

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send "$@" >/dev/null 2>&1 || true
}

# ── Temas ─────────────────────────────────────────────────────────────────────
list_themes() {
    find "$THEMES_DIR" -mindepth 2 -maxdepth 2 -name theme.sh -printf '%h\n' |
        xargs -r -n1 basename | sort
}

current_theme() {
    [[ -r $STATE_FILE ]] && cat "$STATE_FILE" || echo ""
}

# Carrega themes/<nome>/theme.sh nas variáveis globais e aplica os padrões.
load_theme() {
    local name=$1
    local file="$THEMES_DIR/$name/theme.sh"
    [[ -r $file ]] || die "tema '$name' não encontrado em $THEMES_DIR"

    local key
    for key in "${COLOR_KEYS[@]}" "${META_KEYS[@]}"; do unset -v "$key"; done

    # shellcheck disable=SC1090
    source "$file"

    THEME=$name

    # Padrões: nem todo tema precisa declarar tudo.
    : "${variant:=dark}"
    : "${nvim_colorscheme:=default}"
    : "${zen_theme:=}"
    : "${wallpaper:=}"
    : "${gtk_theme:=}"
    : "${cursor_theme:=}"

    : "${term_bg:=$base}"
    : "${black:=$overlay}"
    : "${white:=$text}"

    local c
    for c in black red green yellow blue magenta cyan white; do
        local b="bright_$c"
        [[ -n ${!b:-} ]] || printf -v "$b" '%s' "${!c}"
    done

    for key in "${COLOR_KEYS[@]}"; do
        [[ -n ${!key:-} ]] || die "tema '$name': a cor '$key' não foi definida"
        [[ ${!key} =~ ^#[0-9a-fA-F]{6}$ ]] ||
            die "tema '$name': '$key' = '${!key}' não é um hex #rrggbb"
    done

    if [[ -n $wallpaper ]]; then
        wallpaper_path="$WALLPAPER_DIR/$wallpaper"
        [[ -e $wallpaper_path ]] || warn "wallpaper '$wallpaper' não existe em $WALLPAPER_DIR"
    else
        wallpaper_path=""
    fi
}

# ── Renderização ──────────────────────────────────────────────────────────────
# Substitui {{chave}} e as variantes {{chave:hex}}, {{chave:rgb}} e
# {{chave:argb}} pelo valor da paleta.
render() {
    local content=$1
    local key value bare

    for key in "${COLOR_KEYS[@]}"; do
        value=${!key}
        bare=${value#\#}
        content=${content//\{\{$key\}\}/$value}
        content=${content//\{\{$key:hex\}\}/$bare}
        content=${content//\{\{$key:rgb\}\}/rgb($bare)}
        content=${content//\{\{$key:argb\}\}/0xff$bare}
    done

    content=${content//\{\{theme\}\}/$THEME}
    for key in "${META_KEYS[@]}"; do
        content=${content//\{\{$key\}\}/${!key}}
    done
    content=${content//\{\{wallpaper_path\}\}/$wallpaper_path}

    printf '%s\n' "$content"
}

write_file() {
    local dest=$1 content=$2
    dest=${dest/#\~/$HOME}

    if [[ $DRY == 1 ]]; then
        printf '\033[2;37m[dry]\033[0m %s\n' "$dest"
        return
    fi

    mkdir -p "$(dirname "$dest")"
    # Se o destino ainda for um symlink (layout antigo do stow), remove antes:
    # escrever por cima sujaria o repositório.
    if [[ -L $dest ]]; then rm -f "$dest"; fi
    printf '%s\n' "$content" > "$dest.tmp.$$" && mv -f "$dest.tmp.$$" "$dest"
    printf '   %s\n' "${dest/#$HOME/\~}"
}

generate() {
    local tpl dest content missing
    while read -r tpl dest; do
        [[ -z $tpl || $tpl == \#* ]] && continue
        [[ -r $TEMPLATES_DIR/$tpl ]] || { warn "template '$tpl' não existe, pulando"; continue; }

        content=$(render "$(cat "$TEMPLATES_DIR/$tpl")")

        missing=$(grep -o '{{[^}]*}}' <<< "$content" | sort -u | tr '\n' ' ' || true)
        if [[ -n ${missing// /} ]]; then warn "$tpl: placeholders não resolvidos: $missing"; fi

        write_file "$dest" "$content"
    done < "$MANIFEST"
}

# ── Zen Browser ───────────────────────────────────────────────────────────────
# O Zen não lê nada gerado: cada tema tem seu próprio userChrome/userContent,
# então aqui é só uma troca de symlinks dentro do perfil.
apply_zen() {
    [[ -n $zen_theme ]] || return 0

    local src="$ZEN_THEMES_DIR/$zen_theme"
    [[ -d $src ]] || { warn "zen-theme '$zen_theme' não existe, pulando"; return 0; }

    local chrome
    chrome=$(find "$HOME/.zen" -maxdepth 2 -type d -name chrome 2>/dev/null | head -n 1 || true)
    [[ -n $chrome ]] || { warn "perfil do Zen não encontrado em ~/.zen, pulando"; return 0; }

    if [[ $DRY == 1 ]]; then
        printf '\033[2;37m[dry]\033[0m zen: %s -> %s\n' "$zen_theme" "$chrome"
        return
    fi

    ln -sfn "$src" "$chrome/themes"
    ln -sfn "$src/userChrome.css" "$chrome/userChrome.css"
    ln -sfn "$src/userContent.css" "$chrome/userContent.css"
    printf '   zen: %s\n' "$zen_theme"
}

# ── Recarregar os programas ───────────────────────────────────────────────────
reload_apps() {
    [[ $RELOAD == 1 && $DRY == 0 ]] || return 0

    if command -v hyprctl >/dev/null && pgrep -x Hyprland >/dev/null 2>&1; then
        hyprctl reload >/dev/null 2>&1 || true
        if [[ -n $wallpaper_path && -e $wallpaper_path ]]; then
            hyprctl hyprpaper preload "$wallpaper_path" >/dev/null 2>&1 || true
            hyprctl hyprpaper wallpaper ",$wallpaper_path,cover" >/dev/null 2>&1 || true
        fi
    fi

    # SIGUSR2 recarrega o CSS do waybar (SIGUSR1 é o toggle de visibilidade).
    pkill -USR2 -x waybar >/dev/null 2>&1 || true

    # O ghostty relê a config com SIGUSR2; o quickshell já observa os arquivos
    # e recarrega o Theme.qml sozinho.
    pkill -USR2 -x ghostty >/dev/null 2>&1 || true

    if [[ -n $gtk_theme ]] && command -v gsettings >/dev/null; then
        gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null || true
        gsettings set org.gnome.desktop.interface color-scheme \
            "prefer-${variant}" 2>/dev/null || true
    fi
    if [[ -n $cursor_theme ]] && command -v gsettings >/dev/null; then
        gsettings set org.gnome.desktop.interface cursor-theme "$cursor_theme" 2>/dev/null || true
    fi
}

# ── Comandos ──────────────────────────────────────────────────────────────────
cmd_set() {
    local name=${1:-}
    [[ -n $name ]] || die "uso: theme set <nome>"

    load_theme "$name"
    msg "Aplicando tema '$name'"
    generate
    apply_zen

    if [[ $DRY == 0 ]]; then
        mkdir -p "$STATE_DIR"
        printf '%s\n' "$name" > "$STATE_FILE"
    fi

    reload_apps

    ok "tema '$name' aplicado"
    if [[ $DRY == 0 ]]; then notify "Tema" "Agora usando <b>$name</b>" -i preferences-desktop-theme; fi
    printf '\n   nvim, zathura e shells já abertos só pegam o tema novo ao reiniciar.\n'
    if [[ -n $zen_theme ]]; then printf '   O Zen Browser precisa ser reaberto.\n'; fi
    return 0
}

cmd_show() {
    local name=${1:-$(current_theme)}
    [[ -n $name ]] || die "nenhum tema ativo; use: theme show <nome>"
    load_theme "$name"

    printf '\n  \033[1m%s\033[0m (%s)\n\n' "$THEME" "$variant"
    local key value r g b
    for key in "${COLOR_KEYS[@]}"; do
        value=${!key}
        r=$((16#${value:1:2})); g=$((16#${value:3:2})); b=$((16#${value:5:2}))
        printf '  \033[48;2;%d;%d;%dm      \033[0m  %-16s %s\n' "$r" "$g" "$b" "$key" "$value"
    done
    printf '\n  nvim: %s   zen: %s   wallpaper: %s\n\n' \
        "$nvim_colorscheme" "${zen_theme:--}" "${wallpaper:--}"
}

cmd_pick() {
    local themes current chosen
    themes=$(list_themes)
    current=$(current_theme)

    if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v rofi >/dev/null; then
        local args=(-dmenu -i -p "  Tema")
        if [[ -n $current ]]; then
            local idx
            idx=$(grep -nxF "$current" <<< "$themes" | cut -d: -f1) || true
            if [[ -n $idx ]]; then args+=(-selected-row "$((idx - 1))"); fi
        fi
        chosen=$(rofi "${args[@]}" <<< "$themes") || return 0
    elif command -v fzf >/dev/null; then
        chosen=$(fzf --prompt "Tema > " --height 40% --reverse <<< "$themes") || return 0
    else
        die "instale rofi ou fzf, ou use: theme set <nome>"
    fi

    [[ -n $chosen ]] || return 0
    cmd_set "$chosen"
}

# ── Entrada ───────────────────────────────────────────────────────────────────
args=()
while [[ $# -gt 0 ]]; do
    case $1 in
        --dry|--dry-run) DRY=1 ;;
        --no-reload)     RELOAD=0 ;;
        -h|--help)       sed -n '2,20p' "$self" | sed 's/^# \?//'; exit 0 ;;
        *)               args+=("$1") ;;
    esac
    shift
done
set -- "${args[@]+"${args[@]}"}"

case ${1:-pick} in
    list)    list_themes ;;
    current) current_theme ;;
    set)     shift; cmd_set "${1:-}" ;;
    reload)
        name=$(current_theme)
        [[ -n $name ]] || die "nenhum tema aplicado ainda; use: theme set <nome>"
        cmd_set "$name"
        ;;
    show)    shift; cmd_show "${1:-}" ;;
    pick)    cmd_pick ;;
    *)       die "comando desconhecido '$1' (veja: theme --help)" ;;
esac
