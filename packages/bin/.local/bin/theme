#!/usr/bin/env bash
# theme — troca o tema de todo o desktop de uma vez.
#
#   theme                 abre o seletor (rofi se disponível, senão fzf)
#   theme list            lista os temas disponíveis
#   theme current         mostra o tema ativo
#   theme set <nome>      aplica um tema
#   theme reload          reaplica o tema atual (útil ao editar templates)
#   theme show [<nome>]   imprime a paleta no terminal
#
#   --dry                 mostra o que seria feito, sem escrever nada
#   --no-reload           gera os arquivos mas não recarrega os programas

set -euo pipefail

self=$(realpath "${BASH_SOURCE[0]}")
DOTFILES=${DOTFILES:-$(cd "$(dirname "$self")/../../../.." && pwd)}

THEMES_DIR="$DOTFILES/themes"
TEMPLATES_DIR="$THEMES_DIR/templates"
MANIFEST="$TEMPLATES_DIR/manifest"
ZEN_THEMES_DIR="$DOTFILES/zen-themes"
WALLPAPER_DIR="$DOTFILES/wallpapers"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
STATE_FILE="$STATE_DIR/current-theme"
PROFILE_FILE="$STATE_DIR/profile"
NO_WALLPAPER_FILE="$STATE_DIR/no-wallpaper"

ICON_THEME_NAME="dotfiles"

DRY=0
RELOAD=1

COLOR_KEYS=(
    base surface overlay term_bg
    highlight_low highlight_med highlight_high
    muted subtle text
    black red green yellow blue magenta cyan white
    bright_black bright_red bright_green bright_yellow
    bright_blue bright_magenta bright_cyan bright_white
    accent accent_alt success warning error info
    syn_comment syn_string syn_escape syn_constant syn_keyword syn_operator
    syn_type syn_function syn_variable syn_parameter syn_tag syn_attribute
)
META_KEYS=(
    variant nvim_colorscheme zen_theme wallpaper gtk_theme cursor_theme
    opacity transparent btop_bg
    syn_comment_style syn_keyword_style syn_parameter_style syn_attribute_style
    gtk_prefer_dark qt_icon_theme qt_icon_base
)

msg()   { printf '\033[1;34m::\033[0m %s\n' "$*"; }
ok()    { printf '\033[1;32m ✔\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m !!\033[0m %s\n' "$*" >&2; }
die()   { printf '\033[1;31m ✗\033[0m %s\n' "$*" >&2; exit 1; }

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send "$@" >/dev/null 2>&1 || true
}

list_themes() {
    find "$THEMES_DIR" -mindepth 2 -maxdepth 2 -name theme.sh -printf '%h\n' |
        xargs -r -n1 basename | sort
}

current_theme() {
    [[ -r $STATE_FILE ]] && cat "$STATE_FILE" || echo ""
}

load_theme() {
    local name=$1
    local file="$THEMES_DIR/$name/theme.sh"
    [[ -r $file ]] || die "tema '$name' não encontrado em $THEMES_DIR"

    # -v é obrigatório: sem ele, `unset info` apagaria a função de mesmo nome.
    local key
    for key in "${COLOR_KEYS[@]}" "${META_KEYS[@]}"; do unset -v "$key"; done

    # shellcheck disable=SC1090
    source "$file"

    THEME=$name

    : "${variant:=dark}"
    : "${nvim_colorscheme:=default}"
    : "${zen_theme:=}"
    : "${wallpaper:=}"
    : "${gtk_theme:=}"
    : "${cursor_theme:=}"

    : "${term_bg:=$base}"
    : "${black:=$overlay}"
    : "${white:=$text}"

    # render() não tem condicional: o nvim quer booleano e o btop um fundo vazio.
    : "${opacity:=1}"
    transparent=$(awk -v o="$opacity" 'BEGIN { print (o + 0 < 1) ? "true" : "false" }')
    btop_bg=$([[ $transparent == true ]] && printf '' || printf '%s' "$base")

    gtk_prefer_dark=$([[ $variant == dark ]] && printf 1 || printf 0)

    qt_icon_base=$([[ $variant == dark ]] && printf 'breeze-dark' || printf 'breeze')
    qt_icon_theme=$ICON_THEME_NAME

    local c
    for c in black red green yellow blue magenta cyan white; do
        local b="bright_$c"
        [[ -n ${!b:-} ]] || printf -v "$b" '%s' "${!c}"
    done

    : "${syn_comment:=$muted}"
    : "${syn_string:=$warning}"
    : "${syn_escape:=$accent_alt}"
    : "${syn_constant:=$accent}"
    : "${syn_keyword:=$accent_alt}"
    : "${syn_operator:=$subtle}"
    : "${syn_type:=$success}"
    : "${syn_function:=$info}"
    : "${syn_variable:=$text}"
    : "${syn_parameter:=$subtle}"
    : "${syn_tag:=$accent}"
    : "${syn_attribute:=$warning}"

    # `=` e não `:=`: um tema pode declarar o estilo vazio para desligá-lo.
    : "${syn_comment_style=italic}"
    : "${syn_keyword_style=}"
    : "${syn_parameter_style=italic}"
    : "${syn_attribute_style=italic}"

    for key in "${COLOR_KEYS[@]}"; do
        [[ -n ${!key:-} ]] || die "tema '$name': a cor '$key' não foi definida"
        [[ ${!key} =~ ^#[0-9a-fA-F]{6}$ ]] ||
            die "tema '$name': '$key' = '${!key}' não é um hex #rrggbb"
    done

    # O marcador do `rofi-script wallpaper` prevalece sobre o wallpaper do tema.
    if [[ -n $wallpaper && ! -e $NO_WALLPAPER_FILE ]]; then
        wallpaper_path="$WALLPAPER_DIR/$wallpaper"
        [[ -e $wallpaper_path ]] || warn "wallpaper '$wallpaper' não existe em $WALLPAPER_DIR"
    else
        wallpaper_path=""
    fi
}

# {{chave}} -> #rrggbb, {{chave:hex}} -> rrggbb, {{chave:rgb}} -> rgb(rrggbb),
# {{chave:argb}} -> 0xffrrggbb.
render() {
    local content=$1
    local key value bare

    for key in "${COLOR_KEYS[@]}"; do
        value=${!key}
        bare=${value#\#}
        content=${content//\{\{$key\}\}/$value}
        content=${content//\{\{$key:hex\}\}/$bare}
        content=${content//\{\{$key:rgb\}\}/rgb($bare)}
        content=${content//\{\{$key:argb\}\}/0xff$bare}
    done

    content=${content//\{\{theme\}\}/$THEME}
    for key in "${META_KEYS[@]}"; do
        content=${content//\{\{$key\}\}/${!key}}
    done
    content=${content//\{\{wallpaper_path\}\}/$wallpaper_path}
    # Para quem não aceita `~`, como o `syntect_theme` do yazi.
    content=${content//\{\{home\}\}/$HOME}

    printf '%s\n' "$content"
}

write_file() {
    local dest=$1 content=$2
    dest=${dest/#\~/$HOME}

    if [[ $DRY == 1 ]]; then
        printf '\033[2;37m[dry]\033[0m %s\n' "$dest"
        return
    fi

    mkdir -p "$(dirname "$dest")"
    # Symlink do layout antigo do stow: escrever por cima gravaria no repositório.
    if [[ -L $dest ]]; then rm -f "$dest"; fi
    # Sem rename: o quickshell observa o inode, não o caminho.
    printf '%s\n' "$content" > "$dest"
    printf '   %s\n' "${dest/#$HOME/\~}"
}

current_profile() {
    if [[ -n ${DOTFILES_PROFILE:-} ]]; then printf '%s\n' "$DOTFILES_PROFILE"; return; fi
    if [[ -r $PROFILE_FILE ]]; then
        local name
        read -r name < "$PROFILE_FILE" || true
        if [[ -n ${name// /} ]]; then printf '%s\n' "$name"; return; fi
    fi
    printf 'desktop\n'
}

render_template() {
    local tpl=$1 dest=$2 content missing

    [[ -r $TEMPLATES_DIR/$tpl ]] || { warn "template '$tpl' não existe, pulando"; return 0; }

    content=$(render "$(cat "$TEMPLATES_DIR/$tpl")")

    missing=$(grep -o '{{[^}]*}}' <<< "$content" | sort -u | tr '\n' ' ' || true)
    if [[ -n ${missing// /} ]]; then warn "$tpl: placeholders não resolvidos: $missing"; fi

    write_file "$dest" "$content"
}

generate() {
    local tpl dest profiles wanted name skip profile
    profile=$(current_profile)

    while read -r tpl dest profiles; do
        [[ -z $tpl || $tpl == \#* ]] && continue

        if [[ -n $profiles ]]; then
            skip=1
            IFS=',' read -ra wanted <<< "$profiles"
            for name in "${wanted[@]}"; do
                [[ $name == "$profile" ]] && { skip=0; break; }
            done
            [[ $skip == 1 ]] && continue
        fi

        render_template "$tpl" "$dest"
    done < "$MANIFEST"
}

# O diretório do perfil do Zen tem nome sorteado, por isso fica fora do manifest.
ZEN_GENERATED=(
    zen-colors.css.in:colors.css
    zen-logo.svg.in:zen-logo.svg
)

# O perfil aberto é o `Default=` da seção [Install...] do profiles.ini.
zen_chrome_dir() {
    local ini="$HOME/.zen/profiles.ini" path
    if [[ -r $ini ]]; then
        path=$(awk '/^\[/ { inst = ($0 ~ /^\[Install/) }
                    inst && sub(/^Default=/, "") { print; exit }' "$ini")
        if [[ -n $path && -d $HOME/.zen/$path ]]; then
            printf '%s\n' "$HOME/.zen/$path/chrome"
            return 0
        fi
    fi
    find "$HOME/.zen" -maxdepth 2 -type d -name chrome 2>/dev/null | sort | head -n 1
}

# Sob o qt6ct ninguém reescreve o bloco `.ColorScheme-*` dos SVG do Breeze, então
# um tema herda o Breeze e recolore só esta lista: <categoria>:<ícone>:<chave>.
ICON_RECOLOR=(
    actions:dialog-ok:success
    actions:dialog-ok-apply:success
    actions:dialog-cancel:error
    actions:dialog-close:error
    actions:list-add:success
    actions:list-remove:error
    actions:edit-delete:error
    status:dialog-error:error
    status:dialog-warning:warning
    status:dialog-information:info
)

apply_icons() {
    [[ $(current_profile) == desktop ]] || return 0

    local src="/usr/share/icons/$qt_icon_base"
    if [[ ! -d $src ]]; then
        warn "tema de ícones '$qt_icon_base' não instalado; qt6ct fica sem os recoloridos"
        qt_icon_theme=$qt_icon_base
        return 0
    fi

    local dest="${XDG_DATA_HOME:-$HOME/.local/share}/icons/$ICON_THEME_NAME"
    local entry cat name key color file size dirs=()

    for entry in "${ICON_RECOLOR[@]}"; do
        IFS=':' read -r cat name key <<< "$entry"
        color=${!key}
        [[ -n $color ]] || { warn "apply_icons: chave '$key' vazia, pulando $name"; continue; }

        for file in "$src/$cat"/*/"$name.svg"; do
            [[ -e $file ]] || continue
            size=$(basename "$(dirname "$file")")
            dirs+=("$cat/$size")

            if [[ $DRY == 0 ]]; then
                mkdir -p "$dest/$cat/$size"
                # Por classe, não por hex: o Breeze usa vários azuis. O segundo par é o
                # glifo vazado do crachá dos ícones de status.
                sed -e 's/\(\.ColorScheme-[A-Za-z]* *{ *color: *\)[^;}]*/\1'"$color"'/g' \
                    -e 's/fill="#\(fff\|ffffff\|000\|000000\)"/fill="'"$base"'"/g' \
                    "$file" > "$dest/$cat/$size/$name.svg"
            fi
        done
    done

    if [[ ${#dirs[@]} -eq 0 ]]; then
        warn "apply_icons: nenhum ícone encontrado em $src; qt6ct fica na base"
        qt_icon_theme=$qt_icon_base
        return 0
    fi

    local uniq
    mapfile -t uniq < <(printf '%s\n' "${dirs[@]}" | sort -u)

    if [[ $DRY == 1 ]]; then
        printf '\033[2;37m[dry]\033[0m ícones: %s recoloridos -> %s\n' \
            "${#ICON_RECOLOR[@]}" "${dest/#$HOME/\~}"
        return 0
    fi

    local index="$dest/index.theme" d
    {
        printf '# ARQUIVO GERADO POR `theme set %s` — NÃO EDITE.\n' "$THEME"
        printf '[Icon Theme]\n'
        printf 'Name=%s\n' "$ICON_THEME_NAME"
        printf 'Comment=Ícones do Breeze recoloridos pela paleta do tema\n'
        printf 'Inherits=%s,hicolor\n' "$qt_icon_base"
        printf 'Directories=%s\n' "$(IFS=,; printf '%s' "${uniq[*]}")"
        for d in "${uniq[@]}"; do
            printf '\n[%s]\n' "$d"
            printf 'Size=%s\n' "${d##*/}"
            printf 'Context=%s\n' "$([[ ${d%%/*} == status ]] && printf 'Status' || printf 'Actions')"
            printf 'Type=Fixed\n'
        done
    } > "$index"

    printf '   %s\n' "${index/#$HOME/\~}"
}

apply_zen() {
    [[ -n $zen_theme ]] || return 0
    [[ $(current_profile) == desktop ]] || return 0

    local src="$ZEN_THEMES_DIR/$zen_theme"
    [[ -d $src ]] || { warn "zen-theme '$zen_theme' não existe, pulando"; return 0; }

    local chrome
    chrome=$(zen_chrome_dir)
    [[ -n $chrome ]] || { warn "perfil do Zen não encontrado em ~/.zen, pulando"; return 0; }

    if [[ $DRY == 1 ]]; then
        printf '\033[2;37m[dry]\033[0m zen: %s -> %s\n' "$zen_theme" "$chrome"
    else
        mkdir -p "$chrome"
        # O `themes/` é o que faz os @import internos do estilo resolverem.
        ln -sfn "$src" "$chrome/themes"
        ln -sfn "$src/userChrome.css" "$chrome/userChrome.css"
        ln -sfn "$src/userContent.css" "$chrome/userContent.css"
        printf '   zen: %s\n' "$zen_theme"
    fi

    local pair
    for pair in "${ZEN_GENERATED[@]}"; do
        render_template "${pair%%:*}" "$chrome/${pair##*:}"
    done
}

reload_apps() {
    [[ $RELOAD == 1 && $DRY == 0 ]] || return 0

    if command -v hyprctl >/dev/null && pgrep -x Hyprland >/dev/null 2>&1; then
        hyprctl reload >/dev/null 2>&1 || true
        if [[ -n $wallpaper_path && -e $wallpaper_path ]]; then
            hyprctl hyprpaper wallpaper ",$wallpaper_path,cover" >/dev/null 2>&1 || true
        fi

        # O env-hyprland só troca o cursor no próximo login; isto troca na sessão viva.
        if [[ -n $cursor_theme ]]; then
            hyprctl setcursor "$cursor_theme" 24 >/dev/null 2>&1 || true
        fi
    fi

    # SIGUSR2 recarrega o CSS do waybar (SIGUSR1 é o toggle de visibilidade).
    pkill -USR2 -x waybar >/dev/null 2>&1 || true

    # O ghostty relê a config com SIGUSR2; o quickshell observa os arquivos sozinho.
    pkill -USR2 -x ghostty >/dev/null 2>&1 || true

    # O .tmux.conf inteiro, não só o colors.conf, para o .tmux.conf.local continuar por cima.
    if command -v tmux >/dev/null && tmux info >/dev/null 2>&1; then
        tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true
    fi

    # O color-scheme é o que o portal repassa ao Zen e aos apps GTK4.
    if command -v gsettings >/dev/null; then
        gsettings set org.gnome.desktop.interface color-scheme \
            "prefer-${variant}" 2>/dev/null || true

        if [[ -n $gtk_theme ]]; then
            gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null || true
        fi
        if [[ -n $cursor_theme ]]; then
            gsettings set org.gnome.desktop.interface cursor-theme "$cursor_theme" 2>/dev/null || true
        fi
    fi
}

cmd_set() {
    local name=${1:-}
    [[ -n $name ]] || die "uso: theme set <nome>"

    # O Qt só resolve o tema de ícones ao iniciar; ver o aviso do quickshell no fim.
    local prev=""
    if [[ -r $STATE_FILE ]]; then
        read -r prev < "$STATE_FILE" || true
    fi

    load_theme "$name"
    msg "Aplicando tema '$name'"
    # Antes do generate: decide o qt_icon_theme do qt6ct.conf.
    apply_icons
    generate
    apply_zen

    if [[ $DRY == 0 ]]; then
        mkdir -p "$STATE_DIR"
        printf '%s\n' "$name" > "$STATE_FILE"
    fi

    reload_apps

    ok "tema '$name' aplicado"
    if [[ $DRY == 0 ]]; then notify "Tema" "Agora usando <b>$name</b>" -i preferences-desktop-theme; fi
    printf '\n   nvim, zathura, btop, yazi, lazygit e os apps GTK/Qt já abertos só\n'
    printf '   pegam o tema novo ao reiniciar; shells abertos, no próximo prompt.\n'
    if [[ -n $zen_theme && $(current_profile) == desktop ]]; then
        printf '   O Zen Browser precisa ser reaberto.\n'
    fi
    if [[ -n $prev && $prev != "$name" ]] &&
        pgrep -x quickshell >/dev/null 2>&1; then
        printf '   Reinicie o quickshell, senão o systray fica nos ícones da paleta\n'
        printf '   anterior (pkill quickshell; uwsm app -- quickshell).\n'
    fi
    return 0
}

cmd_show() {
    local name=${1:-$(current_theme)}
    [[ -n $name ]] || die "nenhum tema ativo; use: theme show <nome>"
    load_theme "$name"

    printf '\n  \033[1m%s\033[0m (%s)\n\n' "$THEME" "$variant"
    local key value r g b
    for key in "${COLOR_KEYS[@]}"; do
        value=${!key}
        r=$((16#${value:1:2})); g=$((16#${value:3:2})); b=$((16#${value:5:2}))
        printf '  \033[48;2;%d;%d;%dm      \033[0m  %-16s %s\n' "$r" "$g" "$b" "$key" "$value"
    done
    printf '\n  nvim: %s   zen: %s   wallpaper: %s\n\n' \
        "$nvim_colorscheme" "${zen_theme:--}" "${wallpaper:--}"
}

cmd_pick() {
    local themes current chosen
    themes=$(list_themes)
    current=$(current_theme)

    if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v rofi >/dev/null; then
        local args=(-dmenu -i -p "  Tema")
        if [[ -n $current ]]; then
            local idx
            idx=$(grep -nxF "$current" <<< "$themes" | cut -d: -f1) || true
            if [[ -n $idx ]]; then args+=(-selected-row "$((idx - 1))"); fi
        fi
        chosen=$(rofi "${args[@]}" <<< "$themes") || return 0
    elif command -v fzf >/dev/null; then
        chosen=$(fzf --prompt "Tema > " --height 40% --reverse <<< "$themes") || return 0
    else
        die "instale rofi ou fzf, ou use: theme set <nome>"
    fi

    [[ -n $chosen ]] || return 0
    cmd_set "$chosen"
}

args=()
while [[ $# -gt 0 ]]; do
    case $1 in
        --dry|--dry-run) DRY=1 ;;
        --no-reload)     RELOAD=0 ;;
        -h|--help)       sed -n '2,/^$/{/^#/s/^# \?//p}' "$self"; exit 0 ;;
        *)               args+=("$1") ;;
    esac
    shift
done
set -- "${args[@]+"${args[@]}"}"

case ${1:-pick} in
    list)    list_themes ;;
    current) current_theme ;;
    set)     shift; cmd_set "${1:-}" ;;
    reload)
        name=$(current_theme)
        [[ -n $name ]] || die "nenhum tema aplicado ainda; use: theme set <nome>"
        cmd_set "$name"
        ;;
    show)    shift; cmd_show "${1:-}" ;;
    pick)    cmd_pick ;;
    *)       die "comando desconhecido '$1' (veja: theme --help)" ;;
esac
