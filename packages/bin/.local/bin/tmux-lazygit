#!/usr/bin/env bash
# tmux-lazygit: abre o lazygit pelo tmux-popup, que repassa as opções recebidas.
# O lazygit não tem include: o LG_CONFIG_FILE junta o config.yml e o colors.yml
# gerado pelo `theme set`, e o último vence.

LG_DIR="$HOME/.config/lazygit"
LG_CONFIG_FILE="$LG_DIR/config.yml"
# Antes do primeiro `theme set` o colors.yml não existe, e o lazygit não sobe.
if [[ -f $LG_DIR/colors.yml ]]; then
    LG_CONFIG_FILE="$LG_CONFIG_FILE,$LG_DIR/colors.yml"
fi

exec tmux-popup -w 75% -h 90% -e "LG_CONFIG_FILE=$LG_CONFIG_FILE" -e LANGUAGE=en_US.UTF-8 "$@" lg lazygit
