#!/usr/bin/env bash
# tmux-lazygit: abre o lazygit através do gerenciador de janelas de scratch.

LG_DIR="$HOME/.config/lazygit"
LG_CONFIG_FILE="$LG_DIR/config.yml"

if [[ -f $LG_DIR/colors.yml ]]; then
    LG_CONFIG_FILE="$LG_CONFIG_FILE,$LG_DIR/colors.yml"
fi

exec tmux-popup -e "LG_CONFIG_FILE=$LG_CONFIG_FILE" -e LANGUAGE=en_US.UTF-8 "$@" lg lazygit
