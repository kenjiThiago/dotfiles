#!/usr/bin/env bash

if [[ "$1" == "--paru-install" ]]; then
    pkg_names=$(pacman -Slq | fzf \
        --multi \
        --preview 'paru -Si {1}' \
        --preview-label='alt-p: toggle | alt-j/k: scroll | tab: multi-select' \
        --preview-label-pos='bottom' \
        --preview-window 'down:65%:wrap' \
        --bind 'alt-p:toggle-preview' \
        --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
        --bind 'alt-k:preview-up,alt-j:preview-down' \
        --color 'pointer:green,marker:green')

    if [[ -n $pkg_names ]]; then
        readarray -t pkgs <<< "$pkg_names"
        clear
        echo -e "\033[1;34m➤ Instalando:\033[0m ${pkgs[*]}\n"
        paru -S "${pkgs[@]}"
        echo -e "\n\033[1;32m✔ Concluído!\033[0m"
    fi
    read -p $'\nENTER para sair...'
    exit 0
fi

if [[ "$1" == "--paru-remove" ]]; then
    pkg_names=$(pacman -Qq | fzf --multi --preview 'paru -Qi {1}')

    if [[ -n $pkg_names ]]; then
        readarray -t pkgs <<< "$pkg_names"
        clear
        echo -e "\033[1;31m➤ Removendo:\033[0m ${pkgs[*]}\n"
        paru -Rns "${pkgs[@]}"
        echo -e "\n\033[1;32m✔ Concluído!\033[0m"
    fi
    read -p $'\nENTER para sair...'
    exit 0
fi

if [[ "$1" == "--paru-update" ]]; then
    paru -Syu
    echo -e "\n\033[1;32m✔ Concluído!\033[0m"
    read -p $'\nENTER para sair...'
    exit 0
fi

BACK_TO_EXIT=false
SCRIPT_PATH="$(realpath "$0")"

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
SCREENSHOT_DIR="${XDG_PICTURES_DIR:-$HOME/Imagens}/screenshots"
DOTFILES="${DOTFILES:-$HOME/dotfiles}"
WALLPAPER_DIR="$DOTFILES/wallpapers"
WALLPAPER_CONF="$HOME/.config/hypr/hyprpaper.conf"
HYPR_COLORS="$HOME/.config/hypr/conf/colors.conf"
NO_WALLPAPER="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/no-wallpaper"

toggle_existing_menu() {
    pgrep -x "rofi" >/dev/null && { killall rofi; exit 0; }
}

back_to() {
    if [[ $BACK_TO_EXIT == "true" ]]; then
        exit 0
    elif [[ -n $1 ]]; then
        "$1"
    else
        show_main_menu
    fi
}

menu() {
    local prompt="$1" options="$2" preselect="$3"
    local args=()

    if [[ -n $preselect ]]; then
        local index
        index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
        [[ -n $index ]] && args+=("-selected-row" "$((index - 1))")
    fi

    echo -e "$options" | rofi -dmenu -i -p "$prompt" "${args[@]}" 2>/dev/null
}

terminal()       { uwsm app -- ghostty -e "$@"; }
open_in_editor() {
    notify-send -u low "Editando" "$1"
    uwsm app -- ghostty -e nvim "$1"
}

take_screenshot() {
    local mode="$1"
    local filepath="$SCREENSHOT_DIR/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
    local selection=""
    local picker_pid=""

    # Descongela em qualquer saída, para a tela nunca ficar presa.
    trap '[[ -n "$picker_pid" ]] && kill "$picker_pid" 2>/dev/null' EXIT

    sleep 0.25
    pkill slurp

    case "$mode" in
        region)
            hyprpicker -r -z >/dev/null 2>&1 &
            picker_pid=$!
            sleep 0.5
            selection=$(slurp -b 00000044 -s 00000000 2>/dev/null)
            ;;
        fullscreen)
            selection=$(hyprctl monitors -j | jq -r '.[] | select(.focused==true) | "\(.x),\(.y) \(.width)x\(.height)"')
            ;;
    esac

    [[ -z "$selection" ]] && exit 0

    # Captura antes de descongelar, senão o grim grava o frame ao vivo.
    grim -g "$selection" "$filepath" || exit 1
    [[ -n "$picker_pid" ]] && kill "$picker_pid" 2>/dev/null
    picker_pid=""

    wl-copy < "$filepath"

    # O id não pode ser "default" (por spec não vira botão); -A implica --wait,
    # então o -t é por quanto tempo a ação existe.
    local action
    action=$(notify-send "Captura Salva" "Copiado para a área de transferência." \
        -i "$filepath" -a "Screenshot" -A "edit=Editar com Satty" -t 15000)

    # Sem Vulkan o GDK não acorda a dGPU (~1,8s → ~0,2s para abrir). O env vai
    # dentro do comando porque o uwsm sobe o app por uma unit.
    [[ "$action" == "edit" ]] && uwsm app -- env \
        GDK_DISABLE=vulkan \
        satty \
        --filename "$filepath" \
        --output-filename "$filepath" \
        --save-after-copy \
        --copy-command 'wl-copy'
}

# O cliphist não tem pin: os fixados ficam num diretório à parte, um arquivo por entrada.
CLIP_PINS="${XDG_DATA_HOME:-$HOME/.local/share}/clipboard-pins"
pin_preview() { tr '\n' ' ' < "$1" | cut -c1-120 | sed 's/[[:space:]]*$//'; }

rofi_image_preview() {
    [[ -s $2 ]] && return
    # O Rofi escala pelo maior lado; o espaço transparente evita cortar imagens verticais.
    magick "$1[0]" -auto-orient -thumbnail '440x350' -background none \
        -gravity center -extent 440x440 "$2" 2>/dev/null
}

clipboard_row() {
    local source=$1 label=$2 info=$3 mime icon="" image
    if [[ -n $source ]]; then
        mime=$(file --brief --mime-type -- "$source")
        if [[ $mime == image/* ]]; then
            label=$(magick identify -ping -format 'Imagem · %m · %w×%h' "$source[0]" 2>/dev/null) || label="Imagem ($mime)"
            image="$ROFI_CLIPBOARD_DIR/${info/:/-}.png"
            if rofi_image_preview "$source" "$image"; then
                icon=$image
            fi
        elif [[ $info == pin:* ]]; then
            label=$(pin_preview "$source")
        fi
    fi
    [[ $info == pin:* ]] && label="[fixado] $label"
    printf '%s\0icon\x1f%s\x1finfo\x1f%s\n' "$label" "$icon" "$info"
}

clipboard_rows() {
    local f entry label id image
    local count=0
    printf '\0prompt\x1fClipboard\n\0use-hot-keys\x1ftrue\n\0no-custom\x1ftrue\n'
    printf '\0keep-selection\x1ftrue\n\0keep-filter\x1ftrue\n\0data\x1f\n'

    for f in "$CLIP_PINS"/*; do
        [[ -f $f ]] || continue
        clipboard_row "$f" "" "pin:${f##*/}"
        ((count += 1))
    done

    while IFS= read -r entry; do
        [[ -n $entry ]] || continue
        id=${entry%%$'\t'*}
        [[ $id =~ ^[0-9]+$ ]] || continue
        label=${entry#*$'\t'}
        image=""
        if [[ $label == "[[ binary data "* || $label == "binary data "* ]]; then
            image="$ROFI_CLIPBOARD_DIR/image-$id"
            if [[ ! -f $image ]]; then
                printf '%s\t' "$id" | cliphist decode > "$image" || { rm -f -- "$image"; image=""; }
            fi
        fi
        clipboard_row "$image" "$label" "history:$id"
        ((count += 1))
    done < <(cliphist list)

    if ((count == 0)); then
        printf 'Histórico vazio\0nonselectable\x1ftrue\x1fpermanent\x1ftrue\n'
    fi
}

clipboard_mode() {
    [[ -d ${ROFI_CLIPBOARD_DIR:-} ]] || return
    local kind=${ROFI_INFO%%:*} value=${ROFI_INFO#*:} pinned=""
    if [[ $kind == pin && -n $value && $value != */* && $value != . && $value != .. ]]; then
        pinned="$CLIP_PINS/$value"
    elif [[ $kind != history || ! $value =~ ^[0-9]+$ ]]; then
        kind=""
    fi

    if [[ ${ROFI_DATA:-} == confirm-wipe ]]; then
        if [[ $ROFI_RETV == 1 && $ROFI_INFO == wipe ]]; then
            cliphist wipe
        fi
        clipboard_rows
        printf '\0keep-filter\x1ffalse\n'
        return
    fi

    case $ROFI_RETV in
        0) ;;
        1)
            if [[ -n $pinned ]]; then
                wl-copy < "$pinned" >/dev/null 2>&1
            elif [[ $kind == history ]]; then
                printf '%s\t' "$value" | cliphist decode | wl-copy >/dev/null 2>&1
            else
                clipboard_rows
            fi
            return
            ;;
        10)
            if [[ -n $pinned ]]; then
                rm -f -- "$pinned"
            elif [[ $kind == history ]]; then
                printf '%s\t' "$value" | cliphist decode > "$CLIP_PINS/$(date +%s%N)"
            fi
            ;;
        11)
            if [[ -n $pinned ]]; then
                rm -f -- "$pinned"
            elif [[ $kind == history ]]; then
                printf '%s\t' "$value" | cliphist delete
            fi
            ;;
        12)
            printf '\0prompt\x1fLimpar o histórico?\n\0data\x1fconfirm-wipe\n'
            printf '\0keep-filter\x1ffalse\n\0keep-selection\x1ffalse\n'
            printf 'Não\0info\x1fcancel\nSim\0info\x1fwipe\n'
            return
            ;;
    esac
    clipboard_rows
}

show_clipboard() (
    mkdir -p "$CLIP_PINS"
    local tmp_dir mode
    tmp_dir=$(mktemp -d "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/rofi-clipboard.XXXXXX") || return
    trap 'rm -rf -- "$tmp_dir"' EXIT
    mode=${SCRIPT_PATH//\'/\'\\\'\'}
    ROFI_CLIPBOARD_DIR="$tmp_dir" rofi -show clipboard -modi "clipboard:bash '$mode' --clipboard-mode" \
        -theme "$DOTFILES/packages/rofi/.config/rofi/themes/clipboard.rasi" \
        -kb-custom-1 "alt+p" -kb-custom-2 "alt+d" -kb-custom-3 "alt+w"
)

# Troca só a linha do path nos arquivos gerados pelo `theme set`. O colors.conf
# entra porque o hyprlock tira o fundo do $wallpaper de lá, não do hyprpaper.conf.
save_wallpaper_path() {
    local CAMINHO="$1"

    if [[ -f $WALLPAPER_CONF ]]; then
        sed -i "s|^\( *path *= *\).*|\1$CAMINHO|" "$WALLPAPER_CONF"
    else
        printf 'splash = false\nipc = true\n\nwallpaper {\n    monitor =\n    path = %s\n    fit_mode = cover\n}\n' \
            "$CAMINHO" > "$WALLPAPER_CONF"
    fi

    [[ -f $HYPR_COLORS ]] && sed -i "s|^\(\$wallpaper *= *\).*|\1$CAMINHO|" "$HYPR_COLORS"
}

# O hyprpaper 0.8 não tem IPC de unload: sem wallpaper é ele não rodar. O marcador
# guarda a escolha para o autostart.lua e o `theme`.
turn_wallpaper_off() {
    mkdir -p "$(dirname "$NO_WALLPAPER")"
    touch "$NO_WALLPAPER"
    pkill -x hyprpaper
    save_wallpaper_path ""

    notify-send -a "Hyprpaper" "Wallpaper Removido" "Fundo sólido no tom do tema."
}

change_wallpaper() (
    local SEM_WALLPAPER="󰸉  Sem wallpaper"
    local tmp_dir cache_dir f name icon metadata key selected code index=0 initial=0 CAMINHO
    local -a paths=("")
    cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/rofi/wallpapers/440x350"
    mkdir -p "$cache_dir" || return
    tmp_dir=$(mktemp -d "$cache_dir/.build.XXXXXX") || return
    trap 'rm -rf -- "$tmp_dir"' EXIT

    printf '%s\n' "$SEM_WALLPAPER" > "$tmp_dir/rows"
    for f in "$WALLPAPER_DIR"/*; do
        [[ -f $f ]] || continue
        case ${f,,} in
            *.jpg|*.jpeg|*.png|*.webp|*.jxl) ;;
            *) continue ;;
        esac
        paths+=("$f")
        ((index += 1))
        icon=""
        if metadata=$(stat -Lc '%s:%y:%z' -- "$f"); then
            key=$(printf '%s\0%s' "$f" "$metadata" | sha256sum)
            key=${key%% *}
            if [[ -s $cache_dir/$key.png ]]; then
                icon="$cache_dir/$key.png"
            elif rofi_image_preview "$f" "$tmp_dir/$index.png"; then
                if mv -f -- "$tmp_dir/$index.png" "$cache_dir/$key.png"; then
                    icon="$cache_dir/$key.png"
                fi
            fi
        fi
        name=${f##*/}
        printf '%s\0icon\x1f%s\n' "${name//$'\n'/ }" "$icon" >> "$tmp_dir/rows"
    done
    if ((index > 0)) && [[ ! -e $NO_WALLPAPER ]]; then
        initial=1
    fi

    selected=$(rofi -dmenu -i -no-custom -p "  Wallpaper" -format i \
        -selected-row "$initial" \
        -theme "$DOTFILES/packages/rofi/.config/rofi/themes/wallpaper.rasi" < "$tmp_dir/rows")
    code=$?
    if ((code != 0)) || [[ ! $selected =~ ^[0-9]+$ ]]; then
        back_to show_setup_menu
        return
    fi
    ((selected < ${#paths[@]})) || return

    if ((selected == 0)); then
        turn_wallpaper_off
        return
    fi

    CAMINHO=${paths[selected]}
    rm -f "$NO_WALLPAPER"
    save_wallpaper_path "$CAMINHO"

    if pgrep -x hyprpaper >/dev/null; then
        hyprctl hyprpaper wallpaper ",$CAMINHO,cover"
    else
        # Ele sobe já com o path novo; o IPC ainda não estaria de pé para o comando acima.
        uwsm app -- hyprpaper
    fi

    notify-send -a "Hyprpaper" -i "$CAMINHO" "Wallpaper Atualizado" "Salvo para o próximo boot!"
)

change_keyboard_layout() {
    local kb layouts current choice index
    kb=$(hyprctl devices -j | jq -c '.keyboards[] | select(.main)')
    layouts=$(jq -r '.layout | split(",")[] | gsub(" "; "") | ascii_upcase' <<< "$kb")
    current=$(sed -n "$(($(jq '.active_layout_index' <<< "$kb") + 1))p" <<< "$layouts")

    choice=$(menu "󰌌  Teclado" "$layouts" "$current")
    index=$(grep -nxF "$choice" <<< "$layouts" | cut -d: -f1)
    if [[ -z $choice || -z $index ]]; then
        back_to show_setup_menu
        return
    fi

    hyprctl switchxkblayout all "$((index - 1))" >/dev/null
    if ((index == 1)); then
        notify-send -u low -a "Teclado" "Teclado em $choice"
    else
        notify-send -u low -a "Teclado" "Teclado em $choice" "Super+Shift+Espaço volta para o padrão."
    fi
}

toggle_vpn() {
    if nmcli -t -f NAME connection show --active | grep -qxF USP; then
        nmcli connection down USP >/dev/null && notify-send -u low -a "VPN" "VPN da USP desligada"
        return
    fi

    # Sem --ask a senha é pedida pelo nm-applet, já que aqui não há terminal.
    notify-send -u low -a "VPN" "Conectando na VPN da USP..."
    if nmcli connection up USP >/dev/null 2>&1; then
        notify-send -u low -a "VPN" "VPN da USP ligada"
    else
        notify-send -u critical -a "VPN" "Falha ao conectar na VPN da USP"
    fi
}

show_trigger_menu() {
    case $(menu "Trigger" "  Screenshot (Região)\n  Screenshot (Tela Cheia)\n󰃉  Color Picker\n  Toggle Gaps (Hyprland)") in
        *Região*)       take_screenshot "region" ;;
        *"Tela Cheia"*) take_screenshot "fullscreen" ;;
        *Color*)        sleep 0.25 && hyprpicker -a && notify-send -t 2000 "Color Picker" "Cor copiada" ;;
        *Gaps*)         hyprctl dispatch workspaceopt allfloat ;;
        *)              back_to show_main_menu ;;
    esac
}

show_setup_menu() {
    case $(menu "Setup" "  Clipboard\n  Tema\n  Wallpaper\n󰌌  Teclado\n  Wi-Fi\n󰖂  VPN USP\n  Áudio\n  Hyprland Config\n  Neovim Config\n  Ghostty Config") in
        *Clipboard*) show_clipboard ;;
        *Tema*)      theme pick ;;
        *Wallpaper*) change_wallpaper ;;
        *Teclado*)   change_keyboard_layout ;;
        *Wi-Fi*)     uwsm app -- nm-connection-editor ;;
        *VPN*)       toggle_vpn ;;
        *Áudio*)     uwsm app -- ghostty --class=com.example.wiremix --command=wiremix ;;
        *Hyprland*)  open_in_editor ~/.config/hypr/hyprland.lua ;;
        *Neovim*)    open_in_editor ~/.config/nvim/init.lua ;;
        *Ghostty*)   open_in_editor ~/.config/ghostty/config ;;
        *)           back_to show_main_menu ;;
    esac
}

show_install_remove_menu() {
    case $(menu "Pacotes" "󰉉  Instalar (Paru/FZF)\n󰭌  Remover (Paru/FZF)\n  Atualizar Sistema") in
        *Instalar*)  terminal "$SCRIPT_PATH" --paru-install ;;
        *Remover*)   terminal "$SCRIPT_PATH" --paru-remove ;;
        *Atualizar*) terminal "$SCRIPT_PATH" --paru-update ;;
        *)           back_to show_main_menu ;;
    esac
}

show_system_menu() {
    case $(menu "System" "  Lock\n󰍃  Logout\n󰒲  Suspend\n󰜉  Restart\n󰐥  Shutdown") in
        *Lock*)     loginctl lock-session ;;
        *Logout*)   uwsm stop ;;
        *Suspend*)  systemctl suspend ;;
        *Restart*)  systemctl reboot ;;
        *Shutdown*) systemctl poweroff ;;
        *)          back_to show_main_menu ;;
    esac
}

go_to_menu() {
    case "${1,,}" in
        *apps*)      rofi -show drun -p "Launch" ;;
        *trigger*)   show_trigger_menu ;;
        *setup*)     show_setup_menu ;;
        *pacotes*)   show_install_remove_menu ;;
        *system*)    show_system_menu ;;
        *wallpaper*) change_wallpaper ;;
        *tema*)      theme pick ;;
        *clipboard*) show_clipboard ;;
        *teclado*)   change_keyboard_layout ;;
        *vpn*)       toggle_vpn ;;
    esac
}

show_main_menu() {
    go_to_menu "$(menu "Menu" "󰀻  Apps\n󱓞  Trigger\n  Setup\n󰏔  Pacotes\n  System")"
}

if [[ $1 == --clipboard-mode ]]; then
    clipboard_mode
    exit
fi

mkdir -p "$SCREENSHOT_DIR" "$WALLPAPER_DIR"
[[ "$1" == "--screenshot" ]] && { take_screenshot "$2"; exit 0; }

toggle_existing_menu

if [[ -n $1 ]]; then
    BACK_TO_EXIT=true
    go_to_menu "$1"
else
    show_main_menu
fi
