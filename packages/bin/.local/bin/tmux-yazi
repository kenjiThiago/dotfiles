#!/usr/bin/env bash
# tmux-yazi — abre o yazi num popup

NVIM_SOCKET=${1:-}
TARGET_DIR=${2:-$(pwd)}
TARGET_FILE=${3:-}

# Garante que qualquer popup fantasma/antigo seja encerrado para focar no novo arquivo
tmux kill-session -t scratch-yazi 2>/dev/null

# Constrói o comando de criação da sessão do Tmux
TMUX_CMD=(tmux new-session -d -s scratch-yazi -c "$TARGET_DIR" -e "EDITOR=tmux-yazi-edit")

# Injeta a variável do Neovim, se existir
if [[ -n "$NVIM_SOCKET" ]]; then
    TMUX_CMD+=(-e "NVIM=$NVIM_SOCKET")
fi

# Determina o comando final do Yazi escapando espaços corretamente
if [[ -n "$TARGET_FILE" && -e "$TARGET_FILE" ]]; then
    TARGET_FILE_ESC=$(printf '%q' "$TARGET_FILE")
    TMUX_CMD+=("yazi $TARGET_FILE_ESC")
else
    TMUX_CMD+=("yazi")
fi

# 1. Cria a sessão limpa no background
"${TMUX_CMD[@]}"

# 2. Configura as opções da sessão
tmux set-option -t scratch-yazi status off 2>/dev/null
tmux set-option -t scratch-yazi detach-on-destroy on 2>/dev/null

# 3. Abre o popup apenas fazendo attach na sessão que já está rodando perfeitamente
tmux display-popup -d "$TARGET_DIR" -w 80% -h 80% -E "tmux attach-session -t scratch-yazi"
