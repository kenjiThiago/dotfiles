#!/usr/bin/env bash
# tmux-trocar-sessao: alterna entre as sessões do cliente.
#   tmux-trocar-sessao -n|-p <cliente> <sessão atual>

direcao=$1
cliente=$2
atual=$3

mapfile -t sessoes < <(tmux list-sessions -F '#S')
total=${#sessoes[@]}
((total > 1)) || exit 0

for i in "${!sessoes[@]}"; do
    [[ ${sessoes[i]} == "$atual" ]] && break
done

if [[ $direcao == -p ]]; then
    destino=${sessoes[(i - 1 + total) % total]}
else
    destino=${sessoes[(i + 1) % total]}
fi

tmux switch-client -c "$cliente" -t "=$destino"
