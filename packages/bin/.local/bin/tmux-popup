#!/usr/bin/env bash
# tmux-popup: abre o comando num popup sobre a sessão escondida scratch-<nome>-<sessão>.
# A sessão guarda o estado e dá copy mode ao popup; cada sessão do tmux tem a sua.
# Chamado de dentro do próprio popup, só o fecha, e o estado fica para a próxima.
#
#   tmux-popup [-c cliente] [-s sessão] [-d dir] [-w largura] [-h altura]
#              [-T título] [-e VAR=valor]... <nome> [comando]
#   tmux-popup -k [-s sessão]   mata os popups da sessão (ou o popup em que está)
#
# O nome não leva hífen: é o que separa as partes do nome da sessão escondida.

cliente=""
sessao=""
dir=$PWD
largura=75%
altura=75%
titulo=""
matar=0
ambiente=()

while getopts "c:s:d:w:h:T:e:k" opt; do
    case $opt in
        c) cliente=$OPTARG ;;
        s) sessao=$OPTARG ;;
        d) dir=$OPTARG ;;
        w) largura=$OPTARG ;;
        h) altura=$OPTARG ;;
        T) titulo=$OPTARG ;;
        e) ambiente+=(-e "$OPTARG") ;;
        k) matar=1 ;;
        *) exit 2 ;;
    esac
done
shift $((OPTIND - 1))

[[ -n $sessao ]] || sessao=$(tmux display-message -p '#S')
# O -t lê . e : como separadores de janela e pane; o tmux-sessionizer faz o mesmo.
base=${sessao//[.:]/_}

if ((matar)); then
    if [[ $sessao == scratch-* ]]; then
        tmux kill-session -t "=$sessao"
        exit
    fi
    while read -r s; do
        resto=${s#scratch-}
        [[ $s == scratch-* && ${resto#*-} == "$base" ]] && tmux kill-session -t "=$s"
    done < <(tmux list-sessions -F '#S')
    exit
fi

nome=${1:?uso: tmux-popup [opções] <nome> [comando]}
comando=${2:-}

if [[ $sessao == scratch-* ]]; then
    resto=${sessao#scratch-}
    if [[ ${resto%%-*} == "$nome" ]]; then
        tmux detach-client ${cliente:+-t "$cliente"}
    else
        tmux display-message ${cliente:+-c "$cliente"} "Feche este popup antes de abrir outro"
    fi
    exit
fi

alvo="scratch-$nome-$base"

if ! tmux has-session -t "=$alvo" 2>/dev/null; then
    tmux new-session -d -s "$alvo" -c "$dir" "${ambiente[@]}" ${comando:+"$comando"}
    # O -t do set-option é de pane: sem o ":", o tmux não acha a sessão.
    tmux set-option -t "=$alvo:" status off
    tmux set-option -t "=$alvo:" detach-on-destroy on
fi

popup=(display-popup -w "$largura" -h "$altura")
[[ -n $cliente ]] && popup+=(-c "$cliente")
[[ -n $titulo ]] && popup+=(-T "$titulo")
tmux "${popup[@]}" -E "tmux attach-session -t '=$alvo'"
