#!/usr/bin/env bash
# tmux-popup: gerencia janelas ocultas de "scratch" na sessão atual.

cliente=""
sessao=""
dir=$PWD
largura=75%
altura=75%
titulo=""
matar=0
reordenar=0
ambiente=()

while getopts "c:s:d:w:h:T:e:kR" opt; do
    case $opt in
        c) cliente=$OPTARG ;;
        s) sessao=$OPTARG ;;
        d) dir=$OPTARG ;;
        w) largura=$OPTARG ;;
        h) altura=$OPTARG ;;
        T) titulo=$OPTARG ;;
        e) ambiente+=(-e "$OPTARG") ;;
        k) matar=1 ;;
        R) reordenar=1 ;;
        *) exit 2 ;;
    esac
done
shift $((OPTIND - 1))

[[ -n $sessao ]] || sessao=$(tmux display-message -p '#S')

# Função que varre a sessão e empurra todas as janelas _scratch_ para o fim (99, 98, 97...)
reordenar_scratches() {
    local slot=99
    # Lista apenas os nomes das janelas que começam com _scratch_
    for w in $(tmux list-windows -t "$sessao" -F '#W' 2>/dev/null | grep '^_scratch_'); do
        local idx_atual=$(tmux list-windows -t "$sessao" -F '#{window_index} #W' | awk -v nome="$w" '$2 == nome {print $1}')
        if [[ "$idx_atual" != "$slot" ]]; then
            tmux move-window -d -s "$sessao:$w" -t "$sessao:$slot" 2>/dev/null
        fi
        ((slot--))
    done
}

# Se chamado apenas com a flag -R, organiza as janelas e morre
if ((reordenar)); then
    reordenar_scratches
    exit 0
fi

if ((matar)); then
    while read -r w; do
        [[ $w == _scratch_* ]] && tmux kill-window -t "$sessao:$w"
    done < <(tmux list-windows -t "$sessao" -F '#W' 2>/dev/null)
    exit 0
fi

nome=${1:?uso: tmux-popup [opções] <nome> [comando]}
comando=${2:-}

alvo_nome="_scratch_${nome}_"
janela_alvo="$sessao:$alvo_nome"
janela_atual=$(tmux display-message -p '#W')

if [[ "$janela_atual" == "$alvo_nome" ]]; then
    # Estamos nela. Vamos sair e DEPOIS reordenar.
    tmux last-window ${cliente:+-c "$cliente"}
    reordenar_scratches
    exit 0
fi

if tmux list-windows -t "$sessao" -F '#W' 2>/dev/null | grep -q "^${alvo_nome}$"; then
    # A janela existe, mas não estamos nela.
    # REORDENA PRIMEIRO, FOCA DEPOIS.
    reordenar_scratches
    tmux select-window -t "$janela_alvo"
else
    # Cria a janela em background (-d)
    tmux new-window -d -n "$alvo_nome" -t "$sessao:" -c "$dir" "${ambiente[@]}" ${comando:+"$comando"}
    # REORDENA PRIMEIRO, FOCA DEPOIS.
    reordenar_scratches
    tmux select-window -t "$janela_alvo"
fi
