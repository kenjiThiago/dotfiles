# ARQUIVO GERADO POR `theme set {{theme}}` — NÃO EDITE.
gui:
  theme:
    activeBorderColor:
      - "{{cyan}}"
      - bold
    inactiveBorderColor:
      - "{{muted}}"
    searchingActiveBorderColor:
      - "{{yellow}}"
      - bold
    optionsTextColor:
      - "{{blue}}"
    selectedLineBgColor:
      - "{{overlay}}"
    inactiveViewSelectedLineBgColor:
      - "{{surface}}"
    cherryPickedCommitFgColor:
      - "{{text}}"
    cherryPickedCommitBgColor:
      - "{{magenta}}"
    markedBaseCommitFgColor:
      - "{{text}}"
    markedBaseCommitBgColor:
      - "{{yellow}}"
    unstagedChangesColor:
      - "{{red}}"
    defaultFgColor:
      - "{{text}}"
