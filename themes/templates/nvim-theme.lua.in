-- ARQUIVO GERADO POR `theme set {{theme}}` — NÃO EDITE.
-- Consumido por lua/NeoVim/plugins/colors.lua.
return {
    name        = "{{theme}}",
    variant     = "{{variant}}",
    colorscheme = "{{nvim_colorscheme}}",
    transparent = {{transparent}},

    colors = {
        base    = "{{base}}",
        surface = "{{surface}}",
        overlay = "{{overlay}}",

        highlight_low  = "{{highlight_low}}",
        highlight_med  = "{{highlight_med}}",
        highlight_high = "{{highlight_high}}",

        muted  = "{{muted}}",
        subtle = "{{subtle}}",
        text   = "{{text}}",

        red     = "{{red}}",
        green   = "{{green}}",
        yellow  = "{{yellow}}",
        blue    = "{{blue}}",
        magenta = "{{magenta}}",
        cyan    = "{{cyan}}",

        accent     = "{{accent}}",
        accent_alt = "{{accent_alt}}",
        success    = "{{success}}",
        warning    = "{{warning}}",
        error      = "{{error}}",
        info       = "{{info}}",
    },

    -- Papéis de sintaxe. A paleta acima diz o que cada cor é; isto diz o que
    -- cada cor faz, e um tema pode discordar do mapeamento padrão. Quem
    -- consome é o colorscheme luar; os demais trazem paleta própria.
    syn = {
        comment   = "{{syn_comment}}",
        string    = "{{syn_string}}",
        escape    = "{{syn_escape}}",
        constant  = "{{syn_constant}}",
        keyword   = "{{syn_keyword}}",
        operator  = "{{syn_operator}}",
        type      = "{{syn_type}}",
        func      = "{{syn_function}}",
        variable  = "{{syn_variable}}",
        parameter = "{{syn_parameter}}",
        tag       = "{{syn_tag}}",
        attribute = "{{syn_attribute}}",
    },

    syn_style = {
        comment   = "{{syn_comment_style}}",
        keyword   = "{{syn_keyword_style}}",
        parameter = "{{syn_parameter_style}}",
        attribute = "{{syn_attribute_style}}",
    },
}
