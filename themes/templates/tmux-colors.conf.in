# ARQUIVO GERADO POR `theme set {{theme}}` — NÃO EDITE.
# Hex, nunca nome ANSI: no servidor o ANSI seria o do terminal de quem conectou.
# Os %if poupam erro em tmux mais velho.

set -g status-style bg="{{surface}}",fg="{{text}}"
set -g status-left "#[fg={{brand}},bold] #{=/24/…:session_name} #[default]#[fg={{overlay}}]│#[default] "

# Dentro de condicionais, vírgulas de estilos também seriam separadores dos ramos.
set -g @scratch_inativo '#{?#{m/r:^_scratch_.*_$,#{window_name}},#[fg={{subtle}}] #{s/^_scratch_([^_]+)_$/\1/:window_name} #[default],}'
set -g @scratch_ativo '#{?#{m/r:^_scratch_.*_$,#{window_name}},#[fg={{accent}}]#[bg={{overlay}}]#[bold] #{s/^_scratch_([^_]+)_$/\1/:window_name} #[default],}'

set -g @popups '#{W:#{E:@scratch_inativo},#{E:@scratch_ativo}}'
set -g status-right '#{?client_prefix,#[fg={{accent}}]#[bold] prefix #[default],}#{?#{E:@popups},#[fg={{overlay}}]│#[default] #{E:@popups},} '

set-window-option -g window-status-style fg="{{subtle}}"
set-window-option -g window-status-current-style fg="{{accent}}",bg="{{overlay}}",bold
set-window-option -g window-status-last-style fg="{{text}}"
set-window-option -g window-status-activity-style fg="{{warning}}"
set-window-option -g window-status-bell-style fg="{{error}}",bold

# fill= para a mensagem cobrir a linha toda, e não só os caracteres escritos.
set -g message-style bg="{{overlay}}",fg="{{text}}",fill="{{overlay}}"
set -g message-command-style bg="{{overlay}}",fg="{{accent}}",fill="{{overlay}}"

# noattr (3.6+): sem ele a seleção herda negrito e sublinhado do texto.
%if "#{>=:#{version},3.6}"
set-window-option -g mode-style noattr,bg="{{highlight_med}}",fg=default
%else
set-window-option -g mode-style bg="{{highlight_med}}",fg=default
%endif

%if "#{>=:#{version},3.2}"
set-window-option -g copy-mode-match-style bg="{{overlay}}",fg="{{match}}"
set-window-option -g copy-mode-current-match-style bg="{{accent}}",fg="{{base}}"
set-window-option -g copy-mode-mark-style bg="{{highlight_high}}",fg="{{text}}"
%endif

# Da 3.6 em diante o [0/4] se separa do mode-style.
%if "#{>=:#{version},3.6}"
set-window-option -g copy-mode-position-style bg="{{overlay}}",fg="{{warning}}"
%endif

set-window-option -g pane-border-style fg="{{overlay}}"
set-window-option -g pane-active-border-style "#{?pane_in_mode,fg={{warning}},#{?synchronize-panes,fg={{error}},fg={{accent}}}}"

# Opaco: a transparência é da janela inteira, e com bg=default o popup se
# confundiria com o painel. A borda é neutra, mas visível: com o terminal opaco
# ela é o único limite entre o popup e o painel de trás.
%if "#{>=:#{version},3.3}"
set -g popup-style bg="{{base}}",fg="{{text}}"
set -g popup-border-style fg="{{highlight_med}}",bg="{{base}}"
%endif

%if "#{>=:#{version},3.4}"
set -g menu-style bg="{{surface}}",fg="{{text}}"
set -g menu-selected-style bg="{{overlay}}",fg="{{accent}}",bold
set -g menu-border-style fg="{{highlight_med}}",bg="{{surface}}"
%endif

# Da 3.8 em diante o choose-tree e as barras de rolagem usam cores próprias do tmux.
%if "#{>=:#{version},3.8}"
set-window-option -g tree-mode-border-style fg="{{subtle}}"
set-window-option -g tree-mode-preview-style "fg=#{?#{||:#{&&:#{pane_format},#{pane_active}},#{&&:#{window_format},#{window_active}}},{{accent}},{{text}}},#{?#{||:#{&&:#{pane_format},#{pane_active}},#{&&:#{window_format},#{window_active}}},bold,nobold}"
set-window-option -g switch-mode-match-style bg="{{overlay}}",fg="{{match}}"
set-window-option -g pane-scrollbars-style bg="{{surface}}",fg="{{overlay}}",width=1,pad=0
%endif

set-window-option -g clock-mode-colour "{{accent}}"
set -g display-panes-colour "{{muted}}"
set -g display-panes-active-colour "{{accent}}"
