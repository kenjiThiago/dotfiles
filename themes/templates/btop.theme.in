# ARQUIVO GERADO POR `theme set {{theme}}` — NÃO EDITE.

theme[main_bg]="{{base}}"
theme[main_fg]="{{text}}"
theme[title]="{{subtle}}"
theme[hi_fg]="{{text}}"

theme[selected_bg]="{{highlight_high}}"
theme[selected_fg]="{{yellow}}"
theme[inactive_fg]="{{highlight_med}}"

theme[graph_text]="{{blue}}"
theme[meter_bg]="{{blue}}"
theme[proc_misc]="{{magenta}}"
theme[div_line]="{{muted}}"

theme[cpu_box]="{{cyan}}"
theme[mem_box]="{{green}}"
theme[net_box]="{{magenta}}"
theme[proc_box]="{{accent}}"

theme[temp_start]="{{cyan}}"
theme[temp_mid]="{{yellow}}"
theme[temp_end]="{{accent}}"

theme[cpu_start]="{{yellow}}"
theme[cpu_mid]="{{cyan}}"
theme[cpu_end]="{{accent}}"

theme[free_start]="{{accent}}"
theme[free_mid]="{{accent}}"
theme[free_end]="{{accent}}"

theme[cached_start]="{{magenta}}"
theme[cached_mid]="{{magenta}}"
theme[cached_end]="{{magenta}}"

theme[available_start]="{{green}}"
theme[available_mid]="{{green}}"
theme[available_end]="{{green}}"

theme[used_start]="{{cyan}}"
theme[used_mid]="{{cyan}}"
theme[used_end]="{{cyan}}"

theme[download_start]="{{green}}"
theme[download_mid]="{{blue}}"
theme[download_end]="{{blue}}"

theme[upload_start]="{{cyan}}"
