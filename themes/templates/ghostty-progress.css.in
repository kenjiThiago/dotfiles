/* ARQUIVO GERADO POR `theme set {{theme}}` — NÃO EDITE.
 * Fonte: themes/templates/ghostty-progress.css.in
 */

/* O GTK aparece antes do terminal; fundos diferentes causam um flash na abertura. */
window { background-color: {{base}}; }

progressbar.osd > trough,
progressbar.osd > trough > progress { min-height: 5px; }
progressbar.osd > trough > progress { background-color: {{info}}; }
